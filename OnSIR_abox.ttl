onsir:abox a owl:Ontology ;
    dct:description "ABox of OnSIR: gamma-irradiation studies of seeds and other propagules, each coded as a treatment with its source isotope, the highest dose it irradiated and its dose rate where reported, and an outcome with its subject, endpoint category and source; and the irradiated doses of one cowpea study as dose assessments." ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:imports <https://w3id.org/onsir> ;
    owl:versionInfo "1.6.0" .

