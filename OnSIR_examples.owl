  <rdf:Description rdf:about="https://w3id.org/onsir/examples">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/onsir/examples/1.7.0"/>
    <owl:imports rdf:resource="https://w3id.org/onsir/1.7.0"/>
    <owl:versionInfo>1.7.0</owl:versionInfo>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:title>OnSIR illustrative individuals</dct:title>
    <rdfs:comment>Illustrative individuals showing how a treatment, its outcomes, their responses and a dose-response model are modelled in OnSIR. Every numeric value in this file is invented for illustration and is taken from no study. Outcome_XRay_Mutagenesis carries a dose category and no response, and a reasoner classifies it as a MutagenicOutcome; Outcome_Co60_RootLengthNoResponse is asserted to have no response, and a reasoner classifies it as a NoDetectedResponseOutcome.</rdfs:comment>
  </rdf:Description>
