@prefix dct: <http://purl.org/dc/terms/> .
@prefix onsir: <https://w3id.org/onsir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dct:license a owl:AnnotationProperty .

dct:title a owl:AnnotationProperty .

onsir:Outcome_Co60_GerminationHormesis a owl:NamedIndividual,
        onsir:TreatmentOutcome ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:forEndpoint onsir:example_endpoint_Co60_GerminationHormesis ;
    onsir:hasDoseCategory onsir:example_dose_Co60_GerminationHormesis ;
    onsir:hasModel onsir:Model_BC_Germination ;
    onsir:hasResponse onsir:Resp_GerminationHormesis ;
    onsir:hasSubject onsir:example_seed_Co60_GerminationHormesis ;
    onsir:hasTreatment onsir:Treat_Co60_Gamma_50Gy .

onsir:Outcome_Co60_RootLengthNoResponse a [ a owl:Restriction ;
            owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty onsir:hasResponse ],
        owl:NamedIndividual,
        onsir:TreatmentOutcome ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:forEndpoint onsir:example_endpoint_Co60_RootLength ;
    onsir:hasSubject onsir:example_seed_Co60_GerminationHormesis ;
    onsir:hasTreatment onsir:Treat_Co60_Gamma_50Gy .

onsir:Outcome_UVC_Sterilization a owl:NamedIndividual,
        onsir:TreatmentOutcome ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:forEndpoint onsir:example_endpoint_UVC_Sterilization ;
    onsir:hasDoseCategory onsir:example_dose_UVC_Sterilization ;
    onsir:hasResponse onsir:Resp_Sterility ;
    onsir:hasSubject onsir:example_seed_UVC_Sterilization ;
    onsir:hasTreatment onsir:Treat_UVC_254nm_1200Jm2 .

onsir:Outcome_XRay_Mutagenesis a owl:NamedIndividual,
        onsir:TreatmentOutcome ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:forEndpoint onsir:example_endpoint_XRay_Mutagenesis ;
    onsir:hasDoseCategory onsir:example_dose_XRay_Mutagenesis ;
    onsir:hasSubject onsir:example_seed_XRay_Mutagenesis ;
    onsir:hasTreatment onsir:Treat_XRay_150Gy .

onsir:examples a owl:Ontology ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "OnSIR illustrative individuals" ;
    rdfs:comment "Illustrative individuals showing how a treatment, its outcomes, their responses and a dose-response model are modelled in OnSIR. Every numeric value in this file is invented for illustration and is taken from no study. Outcome_XRay_Mutagenesis carries a dose category and no response, and a reasoner classifies it as a MutagenicOutcome; Outcome_Co60_RootLengthNoResponse is asserted to have no response, and a reasoner classifies it as a NoDetectedResponseOutcome." ;
    owl:imports onsir:1.7.0 ;
    owl:versionIRI <https://w3id.org/onsir/examples/1.7.0> ;
    owl:versionInfo "1.7.0" .

onsir:Model_BC_Germination a owl:NamedIndividual,
        onsir:BrainCousensModel ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:bc_b -2.148e+00 ;
    onsir:bc_c 1.017e-03 ;
    onsir:bc_d 2.433e-03 ;
    onsir:bc_e 5.3e+01 ;
    onsir:bc_f -3.747e-06 .

onsir:Resp_GerminationHormesis a owl:NamedIndividual,
        onsir:HormeticResponse ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:germinationRateIncrease 2.2e-01 ;
    onsir:rootGrowthStimulus 3e-01 .

onsir:Resp_Sterility a owl:NamedIndividual,
        onsir:SterilizationResponse ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:sterilityRate 9.8e-01 .

onsir:Treat_UVC_254nm_1200Jm2 a [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:UV_C ],
        owl:NamedIndividual,
        onsir:SeedIrradiationTreatment ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:hasFluence [ a onsir:QuantityValue ;
            qudt:hasUnit <http://qudt.org/vocab/unit/J-PER-M2> ;
            onsir:numericValue 1.2e+03 ] ;
    onsir:hasWavelength [ a onsir:QuantityValue ;
            qudt:hasUnit <http://qudt.org/vocab/unit/NanoM> ;
            onsir:numericValue 2.54e+02 ] .

onsir:Treat_XRay_150Gy a [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:XRay ],
        owl:NamedIndividual,
        onsir:SeedIrradiationTreatment ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:hasDose [ a onsir:QuantityValue ;
            qudt:hasUnit <http://qudt.org/vocab/unit/GRAY> ;
            onsir:numericValue 1.5e+02 ] .

onsir:example_dose_Co60_GerminationHormesis a owl:NamedIndividual,
        onsir:HormeticDose ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_dose_UVC_Sterilization a owl:NamedIndividual,
        onsir:SterilizationDose ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_dose_XRay_Mutagenesis a owl:NamedIndividual,
        onsir:MutagenicDose ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_endpoint_Co60_GerminationHormesis a owl:NamedIndividual,
        onsir:GerminationRate ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_endpoint_Co60_RootLength a owl:NamedIndividual,
        onsir:RootLength ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_endpoint_UVC_Sterilization a owl:NamedIndividual,
        onsir:SeedSterility ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_endpoint_XRay_Mutagenesis a owl:NamedIndividual,
        onsir:MutationFrequency ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_seed_UVC_Sterilization a owl:NamedIndividual,
        onsir:PlantSeed ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:example_seed_XRay_Mutagenesis a owl:NamedIndividual,
        onsir:PlantSeed ;
    rdfs:comment "Illustrative individual; its values are invented." .

onsir:Treat_Co60_Gamma_50Gy a [ a owl:Restriction ;
            owl:onProperty onsir:hasSourceIsotope ;
            owl:someValuesFrom onsir:Co60 ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:Gamma ],
        owl:NamedIndividual,
        onsir:SeedIrradiationTreatment ;
    rdfs:comment "Illustrative individual; its values are invented." ;
    onsir:hasDose [ a onsir:QuantityValue ;
            qudt:hasUnit <http://qudt.org/vocab/unit/GRAY> ;
            onsir:numericValue 5e+01 ] ;
    onsir:hasDoseRate [ a onsir:QuantityValue ;
            qudt:hasUnit <http://qudt.org/vocab/unit/GRAY-PER-MIN> ;
            onsir:numericValue 2.5e+00 ] ;
    onsir:hasExposureTime [ a onsir:QuantityValue ;
            qudt:hasUnit <http://qudt.org/vocab/unit/MIN> ;
            onsir:numericValue 2e+01 ] .

onsir:example_seed_Co60_GerminationHormesis a owl:NamedIndividual,
        onsir:PlantSeed ;
    rdfs:comment "Illustrative individual; its values are invented." .

