    <rdfs:subClassOf rdf:nodeID="Nbe96b43d736746f0bf72829da9be9e46"/>
    <skos:definition>The observed result of a seed-irradiation treatment on a subject plant structure under a context, recorded with its response, endpoint or endpoint category.</skos:definition>
  </rdf:Description>
