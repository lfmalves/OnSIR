  <rdf:Description rdf:about="https://w3id.org/onsir/HormeticDose">
    <rdfs:label xml:lang="en">Hormetic Dose</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/onsir/DoseCategory"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <rdfs:comment>DEPRECATED. This class names a biological outcome as if it were a property of the dose, which is context-dependent: the same absorbed dose falls in different windows for different taxa. Use AtOrBelowReportedOptimum, which records where a dose falls relative to the values reported for a given taxon and asserts nothing about the outcome.</rdfs:comment>
    <obo:IAO_0100001 rdf:resource="https://w3id.org/onsir/AtOrBelowReportedOptimum"/>
    <skos:definition>A dose in the range that elicits a stimulatory (hormetic) biological response.</skos:definition>
  </rdf:Description>
