    <obo:IAO_0000115>The percentage of seedlings whose cotyledons are free of the seed coat at a stated time after sowing.</obo:IAO_0000115>
    <skos:definition>The percentage of seedlings whose cotyledons are free of the seed coat at a stated time after sowing.</skos:definition>
  </rdf:Description>
