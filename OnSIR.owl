    <rdfs:subClassOf rdf:nodeID="Nb81846575cbc47e08bcf5c36b9a52bf1"/>
    <rdfs:subClassOf rdf:nodeID="Na4a4282580a14196acf08bed77e3f8a4"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <rdfs:subClassOf rdf:nodeID="Ne0f2e622c959431791e0c8a0a1c918c5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Seed Irradiation Treatment</rdfs:label>
    <skos:definition>A treatment process in which seeds are exposed to ionizing radiation of a specified type, source, dose and dose rate.</skos:definition>
  </rdf:Description>
