  <rdf:Description rdf:about="https://w3id.org/onsir/TreatmentOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Reifies the relationship between treatment, subject, endpoint, context, and response.</rdfs:comment>
