  <rdf:Description rdf:about="https://w3id.org/onsir/BelowReportedFavourableBand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <obo:IAO_0000115>A dose assessment whose dose is below the lower end of the favourable band reported for its taxon, endpoint and stage.</obo:IAO_0000115>
