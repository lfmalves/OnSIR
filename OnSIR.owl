  <rdf:Description rdf:about="https://w3id.org/onsir/MutagenicOutcome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Ncc3f471022be483c8c55402cbedbce4e"/>
    <obo:IAO_0000115>A treatment outcome that has a mutagenic response.</obo:IAO_0000115>
    <skos:definition>A treatment outcome that has a mutagenic response.</skos:definition>
    <rdfs:label xml:lang="en">mutagenic outcome</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/onsir/HormeticResponse">
    <rdfs:subClassOf rdf:resource="https://w3id.org/onsir/Response"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">hormetic response</rdfs:label>
    <obo:IAO_0000115>A response observed as a biphasic dose-response: an endpoint exceeds its value in the unirradiated control over a range of low doses and falls below it at higher doses.</obo:IAO_0000115>
    <obo:IAO_0000119>Calabrese EJ, Baldwin LA (2002). Defining hormesis. Human &amp; Experimental Toxicology 21:91-97, doi:10.1191/0960327102ht217oa: hormesis is characterized by biphasic dose responses.</obo:IAO_0000119>
    <skos:definition>A response observed as a biphasic dose-response: an endpoint exceeds its value in the unirradiated control over a range of low doses and falls below it at higher doses.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/onsir/Magnolia_champaca_Germination_AtOrAboveLD50Dose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:equivalentClass rdf:nodeID="Nd1f566776fba4fc5b092fad729805d14"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/onsir/AtOrAboveReportedLD50"/>
    <obo:IAO_0000115>A dose assessment of Magnolia champaca for germination, at a dose of 40 Gy or more, at or above the LD50 that Zanzibar and Sudrajat (2016) place between 30 and 40 Gy.</obo:IAO_0000115>
    <dct:source>Zanzibar and Sudrajat 2016, Indones. J. For. Res. 3(2):95-106, doi:10.20886/ijfr.2016.3.2.95-106</dct:source>
    <onsir:boundQualifier>The source estimates the LD50 by regression of germination lethality relative to the control and places it above 30 Gy and below 40 Gy. Its observations agree: germination at 20 Gy was 65 % of the control and at 40 Gy 24 %.</onsir:boundQualifier>
    <onsir:sourceStatement>Irradiation at dose higher than 30 Gy and below 40 Gy is considered being the lethal dosage (LD50) for M. champaca seeds</onsir:sourceStatement>
    <skos:scopeNote>The source irradiated doses from 5 to 100 Gy and scored germination percentage of fresh seeds in a germination test, as lethality relative to the control; where the window extends past the tested doses, the position is arithmetic only.</skos:scopeNote>
    <skos:definition>A dose assessment of Magnolia champaca for germination, at a dose of 40 Gy or more, at or above the LD50 that Zanzibar and Sudrajat (2016) place between 30 and 40 Gy.</skos:definition>
    <rdfs:label xml:lang="en">Magnolia champaca germination at or above LD50 dose</rdfs:label>
  </rdf:Description>
