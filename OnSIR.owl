    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
    <rdfs:subClassOf rdf:nodeID="Ndbace5c69a104363b65e47feec4fcac9"/>
    <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/PECO_0007151"/>
    <skos:definition>A treatment process in which seeds or other propagules are exposed to radiation of a specified type, source, dose and dose rate.</skos:definition>
  </rdf:Description>
