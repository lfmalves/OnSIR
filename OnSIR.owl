    <rdfs:label xml:lang="en">Endpoint</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
    <skos:definition>A measurable characteristic used to quantify an irradiation outcome (e.g., germination rate, root length, mutation frequency).</skos:definition>
  </rdf:Description>
