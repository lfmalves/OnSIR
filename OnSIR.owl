    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Reifies the relationship between treatment, subject, endpoint, context, and response.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="N3723e1383b3745079bb25fc3dbb11d81"/>
    <rdfs:subClassOf rdf:nodeID="Nb8dc47203b7a4defafb7fe08b0b90510"/>
    <rdfs:subClassOf rdf:nodeID="N90c6e5962c7944349b72336131a28dd0"/>
