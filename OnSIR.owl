  <rdf:Description rdf:about="https://w3id.org/onsir">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <owl:versionIRI rdf:resource="https://w3id.org/onsir/1.4.0"/>
    <owl:versionInfo>1.4.0</owl:versionInfo>
    <dct:title>OnSIR: Ontology for Seed Irradiation and Plant Radiobiology</dct:title>
    <dct:description>A FAIR OWL 2 DL ontology of seed-irradiation treatments and their dose-dependent biological effects, aligned to BFO, PO, NCBITaxon, ChEBI, PATO and ENVO with verified IRIs and to QUDT for units, with dose-to-effect axioms supporting DL reasoning.</dct:description>
    <dct:creator rdf:resource="https://orcid.org/0009-0005-4227-5568"/>
    <dct:creator rdf:resource="https://orcid.org/0000-0001-9504-496X"/>
    <dct:creator rdf:resource="https://orcid.org/0000-0003-3521-9136"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-09-21</dct:created>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-25</dct:modified>
    <rdfs:comment>Canonical IRI https://w3id.org/onsir; source at https://github.com/lfmalves/OnSIR</rdfs:comment>
    <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/rbo.owl"/>
    <dct:source rdf:resource="https://doi.org/10.56238/sevened2025.039-003"/>
    <dct:source rdf:resource="https://doi.org/10.22456/2175-2745.146658"/>
    <dct:source rdf:resource="https://doi.org/10.69547/TSFJB.030203"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/onsir/mutationFrequency">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:label xml:lang="en">mutation frequency</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/onsir/MutagenicResponse"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/onsir/AtOrBelowReportedOptimum">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:definition>A DoseAssessment whose dose is at or below the stimulation optimum reported for its taxon. Being at or below the reported optimum is evidence consistent with a stimulatory response; it does not entail one, and stimulation may also occur above the optimum.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://w3id.org/onsir/DoseAssessment"/>
    <onsir:consistentWithResponse rdf:resource="https://w3id.org/onsir/HormeticResponse"/>
    <rdfs:label xml:lang="en">At Or Below Reported Optimum</rdfs:label>
  </rdf:Description>
