    <rdfs:label xml:lang="en">seed irradiation treatment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/onsir/SeedTreatment"/>
    <rdfs:subClassOf rdf:nodeID="N6ec3b6a9e6094f0983f4dfdc73ad82ff"/>
    <rdfs:subClassOf rdf:nodeID="N10360a390daa45aeaab2189d616202f0"/>
