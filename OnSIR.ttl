onsir:Nicotiana_tabacum_SeedlingPerformance_AboveFavourableBandDose a owl:Class ;
    rdfs:label "Nicotiana tabacum seedling performance above favourable band dose"@en ;
    obo:IAO_0000115 "A dose assessment of Nicotiana tabacum for germination or early seedling growth, at a dose above the favourable band of approximately 5 to 15 Gy that Alves et al. (2027) report." ;
    dct:source "Alves et al. 2027, Radiat. Phys. Chem. 250:114279, doi:10.1016/j.radphyschem.2026.114279" ;
    rdfs:subClassOf onsir:AboveReportedFavourableBand ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_4097 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( onsir:GerminationPercentage onsir:GerminationRate onsir:HypocotylEmergence onsir:CotyledonFreeing onsir:FreshMass ) ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( onsir:GerminationStage onsir:EarlySeedlingStage ) ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 15.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 1.5e+01 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Nicotiana tabacum for germination or early seedling growth, at a dose above the favourable band of approximately 5 to 15 Gy that Alves et al. (2027) report." ;
    skos:scopeNote "The source irradiated doses from 2.5 to 20 Gy and scored germination, hypocotyl emergence and cotyledon liberation from 3 to 9 days after sowing, and seedling fresh weight at two and four weeks, in three varieties; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "Both band ends are approximate: the source places the most favourable responses broadly between approximately 5 and 15 Gy across its endpoints, with the apparent maximum depending on variety, endpoint and sampling time." ;
    onsir:sourceStatement "Across endpoints, the most favorable responses were concentrated broadly between approximately 5 and 15 Gy. The exact position of the apparent maximum depended on variety, endpoint, and sampling time, indicating that no single universal optimum should be assumed for all tobacco genotypes." .

onsir:Nicotiana_tabacum_SeedlingPerformance_BelowFavourableBandDose a owl:Class ;
    rdfs:label "Nicotiana tabacum seedling performance below favourable band dose"@en ;
    obo:IAO_0000115 "A dose assessment of Nicotiana tabacum for germination or early seedling growth, at a dose below the favourable band of approximately 5 to 15 Gy that Alves et al. (2027) report." ;
    dct:source "Alves et al. 2027, Radiat. Phys. Chem. 250:114279, doi:10.1016/j.radphyschem.2026.114279" ;
