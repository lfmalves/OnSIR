    obo:IAO_0000115 "An absorbed-dose rate above 100 Gy per hour." ;
    rdfs:comment "The bound of 100 Gy per hour lies between the two groups of rates reported in the coded corpus, at most 84 and at least 135 Gy per hour." ;
    rdfs:subClassOf onsir:DoseRateCategory ;
    skos:definition "An absorbed-dose rate above 100 Gy per hour." .

onsir:DoseRateBelow100GyPerHour a owl:Class ;
    rdfs:label "dose rate below 100 Gy per hour"@en ;
    obo:IAO_0000115 "An absorbed-dose rate below 100 Gy per hour." ;
    rdfs:comment "The bound of 100 Gy per hour lies between the two groups of rates reported in the coded corpus, at most 84 and at least 135 Gy per hour." ;
    rdfs:subClassOf onsir:DoseRateCategory ;
    skos:definition "An absorbed-dose rate below 100 Gy per hour." .

onsir:FloweringStage a owl:Class ;
    rdfs:label "flowering stage"@en ;
    obo:IAO_0000115 "The stage at which the plant flowers. Radiosensitivity tests often score survival when half of the plants have flowered." ;
    rdfs:subClassOf onsir:LifecycleStage ;
    skos:closeMatch obo:PO_0007616 ;
    skos:definition "The stage at which the plant flowers. Radiosensitivity tests often score survival when half of the plants have flowered." .

onsir:StressResistance a owl:Class ;
    rdfs:label "stress resistance"@en ;
    obo:IAO_0000115 "The capacity of a plant raised from an irradiated propagule to grow under a biotic or abiotic stress, measured against the unirradiated control." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0000164 ;
    skos:definition "The capacity of a plant raised from an irradiated propagule to grow under a biotic or abiotic stress, measured against the unirradiated control." .

onsir:WithinReportedFavourableBand a owl:Class ;
    rdfs:label "within reported favourable band"@en ;
    obo:IAO_0000115 "A dose assessment whose dose lies within the favourable band reported for its taxon, endpoint and stage, both ends included: the band of doses in which the source reports its most favourable responses." ;
    rdfs:subClassOf onsir:DoseAssessment ;
    owl:disjointWith onsir:AtOrAboveReportedLD50 ;
    skos:definition "A dose assessment whose dose lies within the favourable band reported for its taxon, endpoint and stage, both ends included: the band of doses in which the source reports its most favourable responses." ;
    skos:note "Declared disjoint from AtOrAboveReportedLD50, as is BelowReportedFavourableBand, on the assumption that a favourable band lies below the LD50 reported for the same taxon, endpoint and stage. A record coding a band that reaches that LD50 makes the probe class of the band for that endpoint and stage unsatisfiable, and is sent to a curator." ;
    onsir:consistentWithResponse onsir:HormeticResponse .

obo:BFO_0000015 a owl:Class .

obo:NCBITaxon_3917 a owl:Class .

foaf:Person a owl:Class .

onsir:DoseRateCategory a owl:Class ;
    rdfs:label "dose-rate category"@en ;
    obo:IAO_0000115 "A category of absorbed-dose rate, named by the bound that delimits it." ;
    skos:definition "A category of absorbed-dose rate, named by the bound that delimits it." .

onsir:HormeticDose a owl:Class ;
    rdfs:label "hormetic dose"@en ;
    obo:IAO_0000115 "A dose asserted by a curator to have a hormetic effect. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy, hasSubject, forEndpoint and atStage." ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to have a hormetic effect. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy, hasSubject, forEndpoint and atStage." ;
    skos:note "Kept active: an obsolete OBO term carries no logical axioms, and this class is the antecedent of a general class inclusion. DoseAssessment records where a numeric dose lies relative to the statistics reported for its taxon." ;
    skos:related onsir:DoseAssessment .

onsir:MutagenicDose a owl:Class ;
    rdfs:label "mutagenic dose"@en ;
    obo:IAO_0000115 "A dose asserted by a curator to have a mutagenic effect. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy, hasSubject, forEndpoint and atStage." ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to have a mutagenic effect. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy, hasSubject, forEndpoint and atStage." ;
    skos:note "Kept active: an obsolete OBO term carries no logical axioms, and this class is the antecedent of a general class inclusion. DoseAssessment records where a numeric dose lies relative to the statistics reported for its taxon." ;
    skos:related onsir:DoseAssessment .

onsir:SterilizationDose a owl:Class ;
    rdfs:label "sterilization dose"@en ;
    obo:IAO_0000115 "A dose asserted by a curator to have a sterilizing effect. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy, hasSubject, forEndpoint and atStage." ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to have a sterilizing effect. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy, hasSubject, forEndpoint and atStage." ;
    skos:note "Kept active: an obsolete OBO term carries no logical axioms, and this class is the antecedent of a general class inclusion. DoseAssessment records where a numeric dose lies relative to the statistics reported for its taxon." ;
    skos:related onsir:DoseAssessment .

onsir:SterilizationResponse a owl:Class ;
    rdfs:label "sterilization response"@en ;
    obo:IAO_0000115 "A response in which irradiation reduces or abolishes the capacity of the plant grown from the irradiated propagule to produce viable gametes or seed." ;
    rdfs:subClassOf onsir:Response ;
    skos:definition "A response in which irradiation reduces or abolishes the capacity of the plant grown from the irradiated propagule to produce viable gametes or seed." .

onsir:hasDoseCategory a owl:ObjectProperty ;
    rdfs:label "has dose category"@en ;
    obo:IAO_0000115 "Relates a treatment outcome to the dose category a curator asserts for its dose." ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:DoseCategory ;
    skos:definition "Relates a treatment outcome to the dose category a curator asserts for its dose." .

onsir:hasTreatment a owl:ObjectProperty ;
    rdfs:label "has treatment"@en ;
    obo:IAO_0000115 "Relates a treatment outcome to the seed-irradiation treatment that produced it." ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:SeedIrradiationTreatment ;
    skos:definition "Relates a treatment outcome to the seed-irradiation treatment that produced it." .

obo:BFO_0000040 a owl:Class .

onsir:BiochemicalChange a owl:Class ;
    rdfs:label "biochemical change"@en ;
    obo:IAO_0000115 "A biochemical characteristic measured after irradiation, such as the balance of reactive oxygen species, antioxidant content or an enzyme activity; the direction of the change is a result." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:definition "A biochemical characteristic measured after irradiation, such as the balance of reactive oxygen species, antioxidant content or an enzyme activity; the direction of the change is a result." .

onsir:DoseCategory a owl:Class ;
    rdfs:label "dose category"@en ;
    obo:IAO_0000115 "A qualitative classification of an irradiation dose by the biological effect a curator asserts for it." ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) ] ;
    skos:definition "A qualitative classification of an irradiation dose by the biological effect a curator asserts for it." .

onsir:DoseRange a owl:Class ;
    rdfs:label "dose range"@en ;
    obo:IAO_0000115 "The range of absorbed doses irradiated in a study, from its minimum to its maximum dose." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:maxDose ;
            owl:someValuesFrom onsir:QuantityValue ],
        [ a owl:Restriction ;
            owl:onProperty onsir:minDose ;
            owl:someValuesFrom onsir:QuantityValue ] ;
    skos:definition "The range of absorbed doses irradiated in a study, from its minimum to its maximum dose." .

onsir:MutagenicResponse a owl:Class ;
    rdfs:label "mutagenic response"@en ;
    obo:IAO_0000115 "A response in which irradiation induces heritable changes in the genetic material of the irradiated propagule, observed as mutations or chromosomal aberrations in the plant or its progeny." ;
    rdfs:subClassOf onsir:Response ;
    skos:definition "A response in which irradiation induces heritable changes in the genetic material of the irradiated propagule, observed as mutations or chromosomal aberrations in the plant or its progeny." .

onsir:CotyledonFreeing a owl:Class ;
    rdfs:label "cotyledon freeing"@en ;
    obo:IAO_0000115 "The percentage of seedlings whose cotyledons are free of the seed coat at a stated time after sowing." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:definition "The percentage of seedlings whose cotyledons are free of the seed coat at a stated time after sowing." ;
    skos:relatedMatch obo:PO_0007049 .

onsir:FreshMass a owl:Class ;
    rdfs:label "fresh mass"@en ;
    obo:IAO_0000115 "The mass of a seedling, plant or organ weighed fresh." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:broadMatch obo:PATO_0000125 ;
    skos:definition "The mass of a seedling, plant or organ weighed fresh." .

onsir:GerminationRate a owl:Class ;
    rdfs:label "germination rate"@en ;
    obo:IAO_0000115 "The speed of germination of a seed lot, measured as the time to a stated germination percentage or as a germination index." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0000430 ;
    skos:definition "The speed of germination of a seed lot, measured as the time to a stated germination percentage or as a germination index." .

onsir:HypocotylEmergence a owl:Class ;
    rdfs:label "hypocotyl emergence"@en ;
    obo:IAO_0000115 "The percentage of seeds whose hypocotyl has emerged at a stated time after sowing." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:definition "The percentage of seeds whose hypocotyl has emerged at a stated time after sowing." ;
    skos:relatedMatch obo:PO_0007043 .

onsir:LifecycleStage a owl:Class ;
    rdfs:label "life-cycle stage"@en ;
    obo:IAO_0000115 "A stage in the life cycle of a plant at which an endpoint is scored." ;
    rdfs:subClassOf obo:PO_0009012 ;
    skos:definition "A stage in the life cycle of a plant at which an endpoint is scored." .

onsir:PlantPart a owl:Class ;
    rdfs:label "plant part"@en ;
    obo:IAO_0000115 "A material plant structure that can be irradiated and observed: an organ, a tissue, or a propagule such as a seed, bulb, tuber, cutting or callus." ;
    rdfs:subClassOf obo:BFO_0000040,
        obo:PO_0025131 ;
    skos:definition "A material plant structure that can be irradiated and observed: an organ, a tissue, or a propagule such as a seed, bulb, tuber, cutting or callus." .

onsir:QuantityValue a owl:Class ;
    rdfs:label "quantity value"@en ;
    obo:IAO_0000115 "A measured quantity with a numeric value and a unit given as a QUDT unit (absorbed dose in gray, dose rate in gray per hour or per minute, fluence in joule per square metre)." ;
    rdfs:comment "Dose and dose-rate values carry a typed qudt:hasUnit link; absorbed dose is in gray." ;
    owl:equivalentClass qudt:QuantityValue ;
    skos:definition "A measured quantity with a numeric value and a unit given as a QUDT unit (absorbed dose in gray, dose rate in gray per hour or per minute, fluence in joule per square metre)." .

onsir:Context a owl:Class ;
    rdfs:label "context"@en ;
    obo:IAO_0000115 "An experimental or environmental condition under which an outcome was observed." ;
    skos:definition "An experimental or environmental condition under which an outcome was observed." .

onsir:HormeticResponse a owl:Class ;
    rdfs:label "hormetic response"@en ;
    obo:IAO_0000115 "A response observed as a biphasic dose-response: an endpoint exceeds its value in the unirradiated control over a range of low doses and falls below it at higher doses." ;
    obo:IAO_0000119 "Calabrese EJ, Baldwin LA (2002). Defining hormesis. Human & Experimental Toxicology 21:91-97, doi:10.1191/0960327102ht217oa: hormesis is characterized by biphasic dose responses." ;
    rdfs:subClassOf onsir:Response ;
    skos:definition "A response observed as a biphasic dose-response: an endpoint exceeds its value in the unirradiated control over a range of low doses and falls below it at higher doses." .

onsir:Isotope a owl:Class ;
    rdfs:label "radioisotope"@en ;
    obo:IAO_0000115 "A radionuclide used as the source of a seed-irradiation treatment." ;
    skos:definition "A radionuclide used as the source of a seed-irradiation treatment." .

onsir:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en ;
    obo:IAO_0000115 "Relates a treatment outcome to a response observed in it." ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:Response ;
    skos:definition "Relates a treatment outcome to a response observed in it." .

onsir:DoseResponseModel a owl:Class ;
    rdfs:label "dose–response model"@en ;
    obo:IAO_0000115 "A parametric model of how an endpoint varies with dose." ;
    skos:definition "A parametric model of how an endpoint varies with dose." .

onsir:EndpointCategory a owl:Class ;
    rdfs:label "endpoint category"@en ;
    obo:IAO_0000115 "A coarse grouping of measured endpoints, as recorded by the coding scheme of a study corpus. Distinct from Endpoint, which names an individual measurable characteristic." ;
    skos:definition "A coarse grouping of measured endpoints, as recorded by the coding scheme of a study corpus. Distinct from Endpoint, which names an individual measurable characteristic." .

qudt:QuantityValue a owl:Class .

onsir:AtOrAboveReportedLD50 a owl:Class ;
    rdfs:label "at or above reported LD50"@en ;
    obo:IAO_0000115 "A dose assessment whose dose reaches or exceeds the LD50 reported for its taxon, endpoint and stage: the reported estimate, every estimate where the source reports one per genotype or setting, or an upper bound that the source's observations place on the LD50. An LD50 is a 50 % lethality statistic for one endpoint and scoring time." ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A dose assessment whose dose reaches or exceeds the LD50 reported for its taxon, endpoint and stage: the reported estimate, every estimate where the source reports one per genotype or setting, or an upper bound that the source's observations place on the LD50. An LD50 is a 50 % lethality statistic for one endpoint and scoring time." .

onsir:BelowReportedLD50 a owl:Class ;
    rdfs:label "below reported LD50"@en ;
    obo:IAO_0000115 "A dose assessment whose dose is below the LD50 reported for its taxon, endpoint and stage: below the reported estimate, below every estimate where the source reports one per genotype or setting, or at most a dose that the source's own observations place below the LD50." ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A dose assessment whose dose is below the LD50 reported for its taxon, endpoint and stage: below the reported estimate, below every estimate where the source reports one per genotype or setting, or at most a dose that the source's own observations place below the LD50." .

onsir:Response a owl:Class ;
    rdfs:label "response"@en ;
    obo:IAO_0000115 "A biological process in an irradiated plant structure, or in the plant grown from it, observed as a difference from the unirradiated control in one or more endpoints." ;
    rdfs:subClassOf obo:BFO_0000015 ;
    skos:definition "A biological process in an irradiated plant structure, or in the plant grown from it, observed as a difference from the unirradiated control in one or more endpoints." ;
    skos:relatedMatch obo:TO_0000161 .

onsir:SeedlingSurvival a owl:Class ;
    rdfs:label "seedling survival"@en ;
    obo:IAO_0000115 "The percentage of irradiated propagules, or of the seedlings raised from them, alive at a stated time after sowing, often relative to the unirradiated control." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:definition "The percentage of irradiated propagules, or of the seedlings raised from them, alive at a stated time after sowing, often relative to the unirradiated control." ;
    skos:relatedMatch obo:PATO_0000169 .

onsir:GerminationPercentage a owl:Class ;
    rdfs:label "germination percentage"@en ;
    obo:IAO_0000115 "The percentage of sown seeds that germinate within the period of a germination test." ;
    obo:IAO_0000119 "Plant Trait Ontology, TO:0010001 percent germination" ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0010001 ;
    skos:definition "The percentage of sown seeds that germinate within the period of a germination test." .

onsir:RadiationType a owl:Class ;
    rdfs:label "radiation type"@en ;
    obo:IAO_0000115 "A kind of radiation by which a seed-irradiation treatment is delivered." ;
    skos:definition "A kind of radiation by which a seed-irradiation treatment is delivered." .

onsir:GerminationStage a owl:Class ;
    rdfs:label "germination stage"@en ;
    obo:IAO_0000115 "The stage from the imbibition of a seed to the emergence of the radicle or of the seedling, over which germination is scored." ;
    rdfs:subClassOf onsir:LifecycleStage ;
    skos:closeMatch obo:PO_0007057 ;
    skos:definition "The stage from the imbibition of a seed to the emergence of the radicle or of the seedling, over which germination is scored." .

obo:NCBITaxon_4097 a owl:Class .

onsir:EarlySeedlingStage a owl:Class ;
    rdfs:label "early seedling stage"@en ;
    obo:IAO_0000115 "The stage from seedling emergence through the first weeks of growth, over which seedling survival and growth are scored, in the studies coded here from 7 days to about six weeks after sowing." ;
    rdfs:comment "Matched to PO:0007131 seedling development stage by skos:closeMatch: the Plant Ontology seedling stage ends with the first true leaf, and radiosensitivity tests also score seedlings after it." ;
    rdfs:subClassOf onsir:LifecycleStage ;
    skos:closeMatch obo:PO_0007131 ;
    skos:definition "The stage from seedling emergence through the first weeks of growth, over which seedling survival and growth are scored, in the studies coded here from 7 days to about six weeks after sowing." .

onsir:SeedIrradiationTreatment a owl:Class ;
    rdfs:label "seed irradiation treatment"@en ;
    obo:IAO_0000115 "A planned process in which seeds or other plant propagules (bulbs, tubers, cuttings, shoot cultures, callus) are exposed to radiation of a stated type and source, at a stated dose or dose range and, where reported, a stated dose rate." ;
    rdfs:comment "In the OnSIR ABox one treatment individual records the irradiations of one study: a study that irradiated several doses carries a DoseRange from its lowest to its highest dose, and a treatment at a single dose records that dose with hasDose." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:RadiationType ],
        [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:onProperty onsir:hasDose ;
                        owl:someValuesFrom onsir:QuantityValue ] [ a owl:Restriction ;
                        owl:onProperty onsir:hasDoseRange ;
                        owl:someValuesFrom onsir:DoseRange ] [ a owl:Restriction ;
                        owl:onProperty onsir:hasFluence ;
                        owl:someValuesFrom onsir:QuantityValue ] ) ],
        obo:BFO_0000015,
        obo:OBI_0302889,
        onsir:SeedTreatment ;
    skos:broadMatch obo:PECO_0007151 ;
    skos:definition "A planned process in which seeds or other plant propagules (bulbs, tubers, cuttings, shoot cultures, callus) are exposed to radiation of a stated type and source, at a stated dose or dose range and, where reported, a stated dose rate." .

onsir:TreatmentOutcome a owl:Class ;
    rdfs:label "treatment outcome"@en ;
    obo:IAO_0000115 "What was observed in a plant structure after a seed-irradiation treatment, recorded with the treatment, the subject and the response, endpoint or endpoint category observed." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasTreatment ;
            owl:someValuesFrom onsir:SeedIrradiationTreatment ],
        [ a owl:Restriction ;
            owl:onClass onsir:SeedIrradiationTreatment ;
            owl:onProperty onsir:hasTreatment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ;
    skos:definition "What was observed in a plant structure after a seed-irradiation treatment, recorded with the treatment, the subject and the response, endpoint or endpoint category observed." .

onsir:Endpoint a owl:Class ;
    rdfs:label "endpoint"@en ;
    obo:IAO_0000115 "A measurable characteristic of an irradiated plant structure, or of the plant grown from it, used to quantify the outcome of a treatment, such as germination, root length or mutation frequency." ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A measurable characteristic of an irradiated plant structure, or of the plant grown from it, used to quantify the outcome of a treatment, such as germination, root length or mutation frequency." .

onsir:atStage a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "at stage"@en ;
    obo:IAO_0000115 "Relates a dose assessment to the life-cycle stage at which its endpoint is scored." ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range onsir:LifecycleStage ;
    skos:definition "Relates a dose assessment to the life-cycle stage at which its endpoint is scored." .

onsir:doseGy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dose in gray"@en ;
    obo:IAO_0000115 "The absorbed dose of a dose assessment, in gray." ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal xsd:double ) ] ;
    skos:definition "The absorbed dose of a dose assessment, in gray." .

onsir:forEndpoint a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "for endpoint"@en ;
    obo:IAO_0000115 "Relates a dose assessment or a treatment outcome to the endpoint it concerns." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onsir:DoseAssessment onsir:TreatmentOutcome ) ] ;
    rdfs:range onsir:Endpoint ;
    skos:definition "Relates a dose assessment or a treatment outcome to the endpoint it concerns." .

onsir:hasSubject a owl:ObjectProperty ;
    rdfs:label "has subject"@en ;
    obo:IAO_0000115 "Relates a treatment outcome or a dose assessment to the plant structure that was irradiated or observed." ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onsir:DoseAssessment onsir:TreatmentOutcome ) ] ;
    rdfs:range onsir:PlantPart ;
    skos:definition "Relates a treatment outcome or a dose assessment to the plant structure that was irradiated or observed." .

obo:RO_0002162 a owl:ObjectProperty ;
    rdfs:label "in taxon"@en .

onsir:DoseAssessment a owl:Class ;
    rdfs:label "dose assessment"@en ;
    obo:IAO_0000115 "A record of one absorbed dose applied to a plant structure and considered for one endpoint and one life-cycle stage, which a reasoner places relative to the statistics reported for the taxon of the structure." ;
    rdfs:subClassOf obo:IAO_0000030 ;
    skos:definition "A record of one absorbed dose applied to a plant structure and considered for one endpoint and one life-cycle stage, which a reasoner places relative to the statistics reported for the taxon of the structure." .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:DoseRateBelow100GyPerHour onsir:DoseRateAbove100GyPerHour ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:EmergenceAndEarlyVigor onsir:BiochemicalEndpointCategory onsir:GeneticEndpointCategory onsir:MorphologicalEndpointCategory onsir:PlantHealthEndpointCategory onsir:OtherPhysiologicalEndpointCategory ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Gamma onsir:XRay onsir:Neutron onsir:Proton onsir:ElectronBeam onsir:UV_A onsir:UV_B onsir:UV_C ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:BelowReportedFavourableBand onsir:WithinReportedFavourableBand onsir:AboveReportedFavourableBand ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:BelowReportedLD50 onsir:AtOrAboveReportedLD50 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Am241 onsir:Co60 onsir:Cs137 onsir:Ir192 onsir:Xe133 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:HormeticResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:HormeticDose ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticResponse onsir:InhibitoryResponse onsir:LossOfViability onsir:MutagenicResponse onsir:SterilizationResponse ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:MutagenicResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:MutagenicDose ] ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:SterilizationResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:SterilizationDose ] ) .

