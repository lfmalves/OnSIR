    rdfs:label "mutation frequency"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:Nicotiana_tabacum_AboveFavourableBandDose a owl:Class ;
    rdfs:label "Nicotiana tabacum above favourable band dose"@en ;
    dct:source "Alves et al. 2027, Radiat. Phys. Chem. 250:114279, doi:10.1016/j.radphyschem.2026.114279" ;
    rdfs:comment "Dose window for Nicotiana tabacum, bounded by the statistics its source reports." ;
    rdfs:subClassOf onsir:AboveReportedFavourableBand ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Nicotiana_tabacum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 15.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 1.5e+01 ] ) ] ) ] ] ) ] ;
    skos:scopeNote "The source irradiated doses from 2.5 to 20 Gy; where the window extends past them, the position is arithmetic only." ;
    onsir:boundQualifier "Both band ends are approximate: the source places the most favourable responses broadly between approximately 5 and 15 Gy, with the apparent maximum depending on variety, endpoint and sampling time." .

onsir:Nicotiana_tabacum_BelowFavourableBandDose a owl:Class ;
    rdfs:label "Nicotiana tabacum below favourable band dose"@en ;
    dct:source "Alves et al. 2027, Radiat. Phys. Chem. 250:114279, doi:10.1016/j.radphyschem.2026.114279" ;
    rdfs:comment "Dose window for Nicotiana tabacum, bounded by the statistics its source reports." ;
    rdfs:subClassOf onsir:BelowReportedFavourableBand ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Nicotiana_tabacum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 5.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxExclusive 5e+00 ] ) ] ) ] ] ) ] ;
    skos:scopeNote "The source irradiated doses from 2.5 to 20 Gy; where the window extends past them, the position is arithmetic only." ;
    onsir:boundQualifier "Both band ends are approximate: the source places the most favourable responses broadly between approximately 5 and 15 Gy, with the apparent maximum depending on variety, endpoint and sampling time." .

onsir:Nicotiana_tabacum_WithinFavourableBandDose a owl:Class ;
    rdfs:label "Nicotiana tabacum within favourable band dose"@en ;
    dct:source "Alves et al. 2027, Radiat. Phys. Chem. 250:114279, doi:10.1016/j.radphyschem.2026.114279" ;
    rdfs:comment "Dose window for Nicotiana tabacum, bounded by the statistics its source reports." ;
    rdfs:subClassOf onsir:WithinReportedFavourableBand ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Nicotiana_tabacum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 5.0 ] [ xsd:maxInclusive 15.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 5e+00 ] [ xsd:maxInclusive 1.5e+01 ] ) ] ) ] ] ) ] ;
    skos:scopeNote "The source irradiated doses from 2.5 to 20 Gy; where the window extends past them, the position is arithmetic only." ;
    onsir:boundQualifier "Both band ends are approximate: the source places the most favourable responses broadly between approximately 5 and 15 Gy, with the apparent maximum depending on variety, endpoint and sampling time." .

