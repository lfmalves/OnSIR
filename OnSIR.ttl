onsir:SeedStage a owl:Class ;
    rdfs:label "Seed Stage"@en ;
    rdfs:subClassOf onsir:LifecycleStage .

onsir:Seedling a owl:Class ;
    rdfs:label "Seedling"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
