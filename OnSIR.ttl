onsir:boundQualifier a owl:AnnotationProperty ;
    rdfs:label "bound qualifier"@en ;
    skos:definition "The strength at which the source of a dose window states the statistic that bounds it: an approximate band end, a regression estimate or a lower bound." .

onsir:consistentWithResponse a owl:AnnotationProperty ;
    rdfs:label "consistent with response"@en ;
    rdfs:comment "Relates a dose-position class to the response type its sources report within that position." .

onsir:forEndpoint a owl:ObjectProperty ;
    rdfs:label "for endpoint"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onsir:DoseAssessment onsir:TreatmentOutcome ) ] ;
    rdfs:range onsir:Endpoint .

onsir:germinationRateIncrease a owl:DatatypeProperty ;
    rdfs:label "germination rate increase"@en ;
    rdfs:domain onsir:HormeticResponse ;
    rdfs:range xsd:double .

onsir:hasBiochemicalChange a owl:ObjectProperty ;
    rdfs:label "has biochemical change"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:BiochemicalChange .

onsir:hasContext a owl:ObjectProperty ;
    rdfs:label "has context"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:Context .

onsir:hasDoseRange a owl:ObjectProperty ;
    rdfs:label "has dose range"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:DoseRange .

onsir:hasDoseRate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has dose rate"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:hasDoseRateCategory a owl:ObjectProperty ;
    rdfs:label "has dose-rate category"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:DoseRateCategory .

onsir:hasEndpointCategory a owl:ObjectProperty ;
    rdfs:label "has endpoint category"@en ;
    rdfs:comment "relates an outcome to the coarse endpoint category recorded for it in the source corpus" ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:EndpointCategory .

onsir:hasExposureTime a owl:ObjectProperty ;
    rdfs:label "has exposure time"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:hasFluence a owl:ObjectProperty ;
    rdfs:label "has fluence"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:hasModel a owl:ObjectProperty ;
    rdfs:label "has model"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:DoseResponseModel .

onsir:hasSourceIsotope a owl:ObjectProperty ;
    rdfs:label "has source isotope"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:Isotope .

onsir:hasSubject a owl:ObjectProperty ;
    rdfs:label "has subject"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:PlantPart .

onsir:hasTaxon a owl:ObjectProperty ;
    rdfs:label "has taxon"@en ;
    rdfs:comment "relates a plant structure to its taxon, an individual typed with an NCBITaxon class; the structure has the taxon as a property, and PlantSeed stays an anatomical class" ;
    rdfs:domain onsir:PlantPart .

onsir:hasWavelength a owl:ObjectProperty ;
    rdfs:label "has wavelength"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:inducedBy a owl:ObjectProperty ;
    rdfs:label "induced by"@en ;
    owl:inverseOf onsir:induces .

onsir:isTreatmentOf a owl:ObjectProperty ;
    rdfs:label "is treatment of"@en ;
    owl:inverseOf onsir:hasTreatment .

onsir:mutationFrequency a owl:DatatypeProperty ;
    rdfs:label "mutation frequency"@en ;
    rdfs:domain onsir:MutagenicResponse ;
    rdfs:range xsd:double .

onsir:numericValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "numeric value"@en ;
    rdfs:domain onsir:QuantityValue ;
    rdfs:range xsd:double .

onsir:rootGrowthStimulus a owl:DatatypeProperty ;
    rdfs:label "root growth stimulus"@en ;
    rdfs:domain onsir:HormeticResponse ;
    rdfs:range xsd:double .

onsir:sterilityRate a owl:DatatypeProperty ;
    rdfs:label "sterility rate"@en ;
    rdfs:domain onsir:SterilizationResponse ;
    rdfs:range xsd:double .

