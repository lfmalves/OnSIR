onsir:Vigna_unguiculata_SeedlingSurvival_AtOrAboveLD50Dose a owl:Class ;
    rdfs:label "Vigna unguiculata seedling survival at or above LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Vigna unguiculata for seedling survival scored at the flowering stage, at a dose of 250 Gy or more, at which Gnankambary et al. (2019) observed no survival in any genotype they tested." ;
    dct:source "Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33, doi:10.5897/IJGMB2019.0174" ;
    rdfs:subClassOf onsir:AtOrAboveReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_3917 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:FloweringStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 250.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 2.5e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Vigna unguiculata for seedling survival scored at the flowering stage, at a dose of 250 Gy or more, at which Gnankambary et al. (2019) observed no survival in any genotype they tested." ;
    skos:scopeNote "The source irradiated doses from 150 to 300 Gy and scored plants alive at 50 % flowering, relative to the unirradiated control, in three genotypes; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source fits a straight line to survival against dose for each of three genotypes and reports LD50s of 129.8, 132.0 and 150.2 Gy, two of them below the lowest dose tested. Its observations bracket the LD50 of every genotype between 150 and 250 Gy: survival at 150 Gy, the lowest dose, was 56 to 71 %, and at 250 Gy it was zero in all three genotypes; at 200 Gy it was zero in two genotypes, and for the third the table prints 75.86 % in both the lethality and the survival column. The window below the LD50 runs up to 150 Gy and includes it, and the window at or above it starts at 250 Gy; doses above 150 Gy and below 250 Gy fall in no window." ;
    onsir:sourceStatement "Plant survival was recorded at 50% flowering. [...] The (LD50%) for each genotype was estimated through the simple linear regression model considering 100% of seed germination and survival rate of the control." .

onsir:Vigna_unguiculata_SeedlingSurvival_BelowLD50Dose a owl:Class ;
    rdfs:label "Vigna unguiculata seedling survival below LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Vigna unguiculata for seedling survival scored at the flowering stage, at a dose of 150 Gy or less; at 150 Gy, the lowest dose of Gnankambary et al. (2019), more than half of the plants of every genotype they tested survived." ;
    dct:source "Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33, doi:10.5897/IJGMB2019.0174" ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_3917 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:FloweringStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 150.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 1.5e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Vigna unguiculata for seedling survival scored at the flowering stage, at a dose of 150 Gy or less; at 150 Gy, the lowest dose of Gnankambary et al. (2019), more than half of the plants of every genotype they tested survived." ;
    skos:scopeNote "The source irradiated doses from 150 to 300 Gy and scored plants alive at 50 % flowering, relative to the unirradiated control, in three genotypes; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source fits a straight line to survival against dose for each of three genotypes and reports LD50s of 129.8, 132.0 and 150.2 Gy, two of them below the lowest dose tested. Its observations bracket the LD50 of every genotype between 150 and 250 Gy: survival at 150 Gy, the lowest dose, was 56 to 71 %, and at 250 Gy it was zero in all three genotypes; at 200 Gy it was zero in two genotypes, and for the third the table prints 75.86 % in both the lethality and the survival column. The window below the LD50 runs up to 150 Gy and includes it, and the window at or above it starts at 250 Gy; doses above 150 Gy and below 250 Gy fall in no window." ;
    onsir:sourceStatement "Plant survival was recorded at 50% flowering. [...] The (LD50%) for each genotype was estimated through the simple linear regression model considering 100% of seed germination and survival rate of the control." .

