onsir:Triticum_aestivum_SeedlingSurvival_AtOrAboveLD50Dose a owl:Class ;
    rdfs:label "Triticum aestivum seedling survival at or above LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Triticum aestivum for seedling survival in the early seedling stage, at a dose of 278.61 Gy or more, at or above the LD50 of both varieties that Chakraborty et al. (2023) estimate." ;
    dct:source "Chakraborty et al. 2023, Braz. Arch. Biol. Technol. 66:e23220294, doi:10.1590/1678-4324-2023220294" ;
    rdfs:subClassOf onsir:AtOrAboveReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_4565 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:EarlySeedlingStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 278.61 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 2.7861e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Triticum aestivum for seedling survival in the early seedling stage, at a dose of 278.61 Gy or more, at or above the LD50 of both varieties that Chakraborty et al. (2023) estimate." ;
    skos:scopeNote "The source irradiated doses from 200 to 450 Gy and scored viable seedlings 7 days after sowing, in two varieties; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "Probit estimates on survival for two varieties, 272.71 Gy (DBW 187) and 278.61 Gy (K 1006), inside the tested range of 200 to 450 Gy; the window below the LD50 ends below the lower estimate and the window at or above it starts at the higher." ;
    onsir:sourceStatement "The median lethal dose was recorded to be 272.71 Gy and 278.61 Gy in DBW 187 and K 1006 respectively." .

onsir:Triticum_aestivum_SeedlingSurvival_BelowLD50Dose a owl:Class ;
    rdfs:label "Triticum aestivum seedling survival below LD50 dose"@en ;
