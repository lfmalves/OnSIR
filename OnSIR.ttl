obo:BFO_0000040 a owl:Class .

onsir:BiochemicalChange a owl:Class ;
    rdfs:label "Biochemical Change"@en ;
    rdfs:subClassOf onsir:HormeticResponse .

onsir:DoseCategory a owl:Class ;
    rdfs:label "Dose Category"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) ] ;
    skos:definition "A qualitative classification of an irradiation dose by its predominant biological effect." .

onsir:HormeticDose a owl:Class ;
    rdfs:label "Hormetic Dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to belong to this category. NOT RECOMMENDED for new annotation: the category names a biological outcome, which is context-dependent -- the same absorbed dose falls in different windows for different taxa, endpoints and stages. Retained because its logical axioms are load-bearing for data that already carries a dose category. For new curation use AtOrBelowReportedOptimum with a numeric doseGy and a taxon, which records where a dose falls relative to the values reported for that taxon and asserts nothing about the outcome.",
        "A dose in the range that elicits a stimulatory (hormetic) biological response." ;
    skos:note "Discouraged for new annotation; see the definition. Not deprecated: an obsolete OBO term must carry no logical axioms, and this class is an antecedent of an active general class inclusion. AtOrBelowReportedOptimum is a DoseAssessment rather than a DoseCategory, so it is a modelling alternative and not a substitutable replacement." ;
    skos:related onsir:AtOrBelowReportedOptimum .

onsir:LifecycleStage a owl:Class ;
    rdfs:label "Lifecycle Stage"@en .

onsir:MutagenicDose a owl:Class ;
    rdfs:label "Mutagenic Dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to belong to this category. NOT RECOMMENDED for new annotation: the category names a biological outcome, which is context-dependent -- the same absorbed dose falls in different windows for different taxa, endpoints and stages. Retained because its logical axioms are load-bearing for data that already carries a dose category. For new curation use AboveReportedOptimum with a numeric doseGy and a taxon, which records where a dose falls relative to the values reported for that taxon and asserts nothing about the outcome.",
        "A dose in the range that elicits induced genetic variability (mutagenesis) without predominant sterilization." ;
    skos:note "Discouraged for new annotation; see the definition. Not deprecated: an obsolete OBO term must carry no logical axioms, and this class is an antecedent of an active general class inclusion. AboveReportedOptimum is a DoseAssessment rather than a DoseCategory, so it is a modelling alternative and not a substitutable replacement." ;
    skos:related onsir:AboveReportedOptimum .

onsir:SterilizationDose a owl:Class ;
    rdfs:label "Sterilization Dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to belong to this category. NOT RECOMMENDED for new annotation: the category names a biological outcome, which is context-dependent -- the same absorbed dose falls in different windows for different taxa, endpoints and stages. Retained because its logical axioms are load-bearing for data that already carries a dose category. For new curation use AtOrAboveReportedLD50 with a numeric doseGy and a taxon, which records where a dose falls relative to the values reported for that taxon and asserts nothing about the outcome.",
        "A dose high enough to cause predominant loss of viability or reproductive capacity." ;
    skos:note "Discouraged for new annotation; see the definition. Not deprecated: an obsolete OBO term must carry no logical axioms, and this class is an antecedent of an active general class inclusion. AtOrAboveReportedLD50 is a DoseAssessment rather than a DoseCategory, so it is a modelling alternative and not a substitutable replacement." ;
    skos:related onsir:AtOrAboveReportedLD50 .

onsir:PlantSeed a owl:Class ;
    rdfs:label "Plant Seed"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass obo:PO_0009010 .

onsir:QuantityValue a owl:Class ;
    rdfs:label "Quantity value"@en ;
    rdfs:comment "dose rate values carry a typed qudt:unit link; the unit asserted is gray per hour",
        "dose values carry a typed qudt:unit link; absorbed dose is in gray" ;
    owl:equivalentClass qudt:QuantityValue ;
    skos:definition "A measured quantity with a numeric value and a unit (dose in gray, dose rate in gray per minute)." .

onsir:AboveReportedOptimum a owl:Class ;
    rdfs:label "Above Reported Optimum"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose exceeds the reported stimulation optimum but is below the reported early-viability LD50. This is not by itself evidence of mutagenesis: mutation induction may begin below the optimum and continue above the LD50, and depends on the endpoint." ;
    onsir:consistentWithResponse onsir:MutagenicResponse .

onsir:AtOrAboveReportedLD50 a owl:Class ;
    rdfs:label "At Or Above Reported LD50"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose reaches or exceeds the early-viability LD50 reported for its taxon. LD50 is a 50% lethality statistic, NOT a sterilization threshold; inferring sterility requires reproductive evidence, which this class does not assert." ;
    onsir:consistentWithResponse onsir:SterilizationResponse .

onsir:AtOrBelowReportedOptimum a owl:Class ;
    rdfs:label "At Or Below Reported Optimum"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose is at or below the stimulation optimum reported for its taxon. Being at or below the reported optimum is evidence consistent with a stimulatory response; it does not entail one, and stimulation may also occur above the optimum." ;
    onsir:consistentWithResponse onsir:HormeticResponse .

onsir:Context a owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "Experimental or environmental conditions relevant to outcomes."@en .

onsir:Isotope a owl:Class ;
    rdfs:label "Radioisotope"@en .

onsir:SterilizationResponse a owl:Class ;
    rdfs:label "Sterilization Response"@en ;
    rdfs:subClassOf onsir:Response .

onsir:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:Response .

onsir:DoseResponseModel a owl:Class ;
    rdfs:label "Dose–Response Model"@en ;
    skos:definition "A parametric model describing how an endpoint varies with dose (e.g., the Brain-Cousens hormetic model)." .

onsir:EndpointCategory a owl:Class ;
    rdfs:label "Endpoint Category"@en ;
    skos:definition "A coarse grouping of measured endpoints, as recorded by a systematic review's coding scheme. Distinct from Endpoint, which names an individual measurable characteristic." .

onsir:MutagenicResponse a owl:Class ;
    rdfs:label "Mutagenic Response"@en ;
    rdfs:subClassOf onsir:Response .

onsir:Response a owl:Class ;
    rdfs:label "Response"@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticResponse onsir:MutagenicResponse onsir:SterilizationResponse ) ] .

onsir:HormeticResponse a owl:Class ;
    rdfs:label "Hormetic Response"@en ;
    rdfs:subClassOf onsir:Response ;
    skos:definition "A beneficial, stimulatory response to low-dose irradiation (e.g., enhanced germination, vigour, or stress resistance)." .

onsir:RadiationType a owl:Class ;
    rdfs:label "Radiation Type"@en .

onsir:doseGy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "Dose Gy"@en ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal xsd:double ) ] ;
    skos:definition "absorbed dose, expressed in gray" .

onsir:forTaxon a owl:ObjectProperty ;
    rdfs:label "For Taxon"@en ;
    rdfs:comment "the taxon the assessment is relative to" ;
    rdfs:domain onsir:DoseAssessment .

onsir:Endpoint a owl:Class ;
    rdfs:label "Endpoint"@en ;
    rdfs:comment "Measured response variable used to assess treatment effects."@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A measurable characteristic used to quantify an irradiation outcome (e.g., germination rate, root length, mutation frequency)." .

qudt:QuantityValue a owl:Class .

onsir:SeedIrradiationTreatment a owl:Class ;
    rdfs:label "Seed Irradiation Treatment"@en ;
    rdfs:comment "Irradiation applied to seeds using ionizing or non-ionizing radiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass onsir:QuantityValue ;
            owl:onProperty onsir:hasDose ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty onsir:induces ;
            owl:someValuesFrom onsir:Response ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:RadiationType ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasDose ;
            owl:someValuesFrom onsir:QuantityValue ],
        obo:BFO_0000015,
        onsir:SeedTreatment ;
    skos:definition "A treatment process in which seeds are exposed to ionizing radiation of a specified type, source, dose and dose rate." .

onsir:TreatmentOutcome a owl:Class ;
    rdfs:label "Treatment Outcome"@en ;
    rdfs:comment "Reifies the relationship between treatment, subject, endpoint, context, and response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass onsir:SeedIrradiationTreatment ;
            owl:onProperty onsir:hasTreatment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:Response ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasTreatment ;
            owl:someValuesFrom onsir:SeedIrradiationTreatment ] ;
    skos:definition "The observed result of a seed-irradiation treatment on a subject seed under a context, characterized by a dose category and a biological response for a given endpoint." .

onsir:DoseAssessment a owl:Class ;
    rdfs:label "Dose Assessment"@en ;
    skos:definition "A numeric absorbed dose considered for a given taxon, endpoint and stage; the unit of context-dependent dose positioning." .

xsd:double a owl:Class .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:LowDoseRate onsir:HighDoseRate ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:AtOrBelowReportedOptimum onsir:AboveReportedOptimum onsir:AtOrAboveReportedLD50 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticResponse onsir:MutagenicResponse onsir:SterilizationResponse ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Am241 onsir:Co60 onsir:Cs137 onsir:Ir192 onsir:Xe133 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Gamma onsir:XRay onsir:Neutron onsir:Proton onsir:ElectronBeam onsir:UV_A onsir:UV_B onsir:UV_C ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:SterilizationResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:SterilizationDose ] ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:MutagenicResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:MutagenicDose ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:EmergenceAndEarlyVigor onsir:BiochemicalEndpointCategory onsir:GeneticEndpointCategory onsir:MorphologicalEndpointCategory onsir:PlantHealthEndpointCategory onsir:OtherPhysiologicalEndpointCategory ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:HormeticResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:HormeticDose ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) .

