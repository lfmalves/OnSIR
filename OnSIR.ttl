onsir:WaterQuality a owl:Class ;
    rdfs:label "Water Quality"@en ;
    rdfs:subClassOf onsir:Context ;
    skos:closeMatch obo:CHEBI_15377 .

onsir:atStage a owl:ObjectProperty ;
    rdfs:label "At Stage"@en ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range onsir:LifecycleStage .

onsir:bc_b a owl:DatatypeProperty ;
    rdfs:label "BC parameter b"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_c a owl:DatatypeProperty ;
    rdfs:label "BC parameter c"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_d a owl:DatatypeProperty ;
    rdfs:label "BC parameter d"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_e a owl:DatatypeProperty ;
    rdfs:label "BC parameter e"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_f a owl:DatatypeProperty ;
    rdfs:label "BC parameter f"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:consistentWithResponse a owl:AnnotationProperty ;
    rdfs:comment "Relates a dose-position class to the response type it is evidentially compatible with. This is an annotation, deliberately NOT a subclass axiom: no biological response is entailed by the position of a dose relative to a reported statistic." .

onsir:forEndpoint a owl:ObjectProperty ;
    rdfs:label "for endpoint"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( onsir:DoseAssessment onsir:TreatmentOutcome ) ] ;
    rdfs:range onsir:Endpoint .

onsir:germinationRateIncrease a owl:DatatypeProperty ;
    rdfs:label "germination rate increase"@en ;
    rdfs:domain onsir:HormeticResponse ;
    rdfs:range xsd:double .

onsir:hasBiochemicalChange a owl:ObjectProperty ;
    rdfs:label "has biochemical change"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:BiochemicalChange ;
    rdfs:subPropertyOf onsir:induces .

onsir:hasContext a owl:ObjectProperty ;
    rdfs:label "has context"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
