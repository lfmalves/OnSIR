onsir:hasSubject a owl:ObjectProperty ;
    rdfs:label "has subject"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:PlantSeed .

onsir:hasTaxon a owl:ObjectProperty ;
    rdfs:label "Has Taxon"@en ;
    rdfs:comment "relates a plant structure to its taxon; taxonomic identity is not an anatomical type, so PlantSeed is never asserted to be a subclass of an NCBITaxon class" ;
