    rdfs:subClassOf onsir:RadiationType .

onsir:EmergenceAndEarlyVigor a owl:Class ;
    rdfs:label "emergence and early vigour"@en ;
    rdfs:subClassOf onsir:EndpointCategory ;
    skos:definition "Emergence and early vigour." .

onsir:Gamma a owl:Class ;
    rdfs:label "gamma"@en ;
    rdfs:subClassOf onsir:RadiationType ;
    skos:relatedMatch obo:PECO_0001022 .

onsir:GeneticEndpointCategory a owl:Class ;
    rdfs:label "genetic endpoint category"@en ;
    rdfs:subClassOf onsir:EndpointCategory ;
    skos:definition "Genetic endpoints." .

onsir:HighDoseRate a owl:Class ;
    rdfs:label "high dose rate"@en ;
    rdfs:subClassOf onsir:DoseRateCategory ;
    skos:definition "A reported dose rate above 100 Gy h-1, the cut placed in the gap between the corpus rates of 78 and 303 Gy h-1; every rate in the corpus is an acute exposure." .

onsir:Ir192 a owl:Class ;
    rdfs:label "iridium-192"@en ;
    rdfs:subClassOf onsir:Isotope .

onsir:LowDoseRate a owl:Class ;
    rdfs:label "low dose rate"@en ;
    rdfs:subClassOf onsir:DoseRateCategory ;
    skos:definition "A reported dose rate below 100 Gy h-1, the cut placed in the gap between the corpus rates of 78 and 303 Gy h-1; every rate in the corpus is an acute exposure." .

onsir:MorphologicalEndpointCategory a owl:Class ;
    rdfs:label "morphological endpoint category"@en ;
    rdfs:subClassOf onsir:EndpointCategory ;
    skos:definition "Morphological and anatomical endpoints." .

onsir:Neutron a owl:Class ;
    rdfs:label "neutron"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:OtherPhysiologicalEndpointCategory a owl:Class ;
    rdfs:label "other physiological endpoint category"@en ;
    rdfs:subClassOf onsir:EndpointCategory ;
    skos:definition "Other physiological endpoints." .

onsir:PlantHealthEndpointCategory a owl:Class ;
    rdfs:label "plant health endpoint category"@en ;
    rdfs:subClassOf onsir:EndpointCategory ;
    skos:definition "Plant-health (phytosanitary) endpoints." .

onsir:Proton a owl:Class ;
    rdfs:label "proton"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:SeedTreatment a owl:Class ;
    rdfs:label "seed treatment"@en ;
    rdfs:comment "Any pre-sowing treatment applied to seeds."@en ;
    rdfs:subClassOf obo:BFO_0000015 .

onsir:UV_A a owl:Class ;
    rdfs:label "UV-A"@en ;
    rdfs:subClassOf onsir:RadiationType ;
    skos:relatedMatch obo:PECO_0007222 .

onsir:UV_B a owl:Class ;
    rdfs:label "UV-B"@en ;
    rdfs:subClassOf onsir:RadiationType ;
    skos:relatedMatch obo:PECO_0007222 .

onsir:UV_C a owl:Class ;
    rdfs:label "UV-C"@en ;
    rdfs:subClassOf onsir:RadiationType ;
    skos:relatedMatch obo:PECO_0007222 .

onsir:XRay a owl:Class ;
    rdfs:label "X-ray"@en ;
    rdfs:subClassOf onsir:RadiationType ;
    skos:relatedMatch obo:PECO_0007628 .

onsir:Xe133 a owl:Class ;
    rdfs:label "xenon-133"@en ;
    rdfs:subClassOf onsir:Isotope .

onsir:hasRadiationType a owl:ObjectProperty ;
    rdfs:label "has radiation type"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:RadiationType .

onsir:maxDose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "maximum dose"@en ;
    rdfs:domain onsir:DoseRange ;
    rdfs:range qudt:QuantityValue .

onsir:minDose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "minimum dose"@en ;
    rdfs:domain onsir:DoseRange ;
    rdfs:range qudt:QuantityValue .

onsir:taxon_Trigonella_foenum_graecum a obo:NCBITaxon_78534,
        owl:NamedIndividual ;
    rdfs:label "Trigonella foenum-graecum" .

onsir:AboveReportedFavourableBand a owl:Class ;
    rdfs:label "above reported favourable band"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose exceeds the upper end of the favourable band reported for its taxon." .

onsir:BelowReportedFavourableBand a owl:Class ;
    rdfs:label "below reported favourable band"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    owl:disjointWith onsir:AtOrAboveReportedLD50 ;
    skos:definition "A DoseAssessment whose dose is below the lower end of the favourable band reported for its taxon." .

onsir:StressResistance a owl:Class ;
    rdfs:label "stress resistance"@en ;
    rdfs:subClassOf onsir:HormeticResponse .

onsir:WithinReportedFavourableBand a owl:Class ;
    rdfs:label "within reported favourable band"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    owl:disjointWith onsir:AtOrAboveReportedLD50 ;
    skos:definition "A DoseAssessment whose dose lies within the favourable band reported for its taxon, both ends included: the band of doses in which the source reports its most favourable responses. The position is evidence compatible with a stimulatory response." ;
    skos:note "Declared disjoint from AtOrAboveReportedLD50, as is BelowReportedFavourableBand, on the assumption that a taxon's favourable band lies below its LD50. A record coding a band that reaches its LD50 makes the ontology inconsistent and is sent to a curator." ;
    onsir:consistentWithResponse onsir:HormeticResponse .

onsir:hasDose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has absorbed dose"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:induces a owl:ObjectProperty ;
    rdfs:label "induces"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:Response .

onsir:taxon_Vigna_unguiculata a obo:NCBITaxon_3917,
        owl:NamedIndividual ;
    rdfs:label "Vigna unguiculata" .

obo:BFO_0000015 a owl:Class .

foaf:Person a owl:Class .

onsir:BelowReportedLD50 a owl:Class ;
    rdfs:label "below reported LD50"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose is below the LD50 reported for its taxon, or below a reported lower bound on that LD50." .

onsir:DoseRange a owl:Class ;
    rdfs:label "dose range"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:maxDose ;
            owl:someValuesFrom onsir:QuantityValue ],
        [ a owl:Restriction ;
            owl:onProperty onsir:minDose ;
            owl:someValuesFrom onsir:QuantityValue ] .

onsir:DoseRateCategory a owl:Class ;
    rdfs:label "dose-rate category"@en .

onsir:HormeticDose a owl:Class ;
    rdfs:label "hormetic dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to belong to this category. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy and forTaxon." ;
    skos:note "Kept active: an obsolete OBO term carries no logical axioms, and this class is the antecedent of a general class inclusion. DoseAssessment records where a numeric dose lies relative to the statistics reported for its taxon." ;
    skos:related onsir:DoseAssessment .

onsir:MutagenicDose a owl:Class ;
    rdfs:label "mutagenic dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to belong to this category. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy and forTaxon." ;
    skos:note "Kept active: an obsolete OBO term carries no logical axioms, and this class is the antecedent of a general class inclusion. DoseAssessment records where a numeric dose lies relative to the statistics reported for its taxon." ;
    skos:related onsir:DoseAssessment .

onsir:SterilizationDose a owl:Class ;
    rdfs:label "sterilization dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose asserted by a curator to belong to this category. Discouraged for new annotation: the category names a biological outcome, and the outcome of one absorbed dose depends on taxon, endpoint and stage. Retained because data that already carries a dose category reasons through its axioms. Record the category as an individual typed with this class; the general class inclusion reads that typing. For new curation, record the numeric dose as a DoseAssessment with doseGy and forTaxon." ;
    skos:note "Kept active: an obsolete OBO term carries no logical axioms, and this class is the antecedent of a general class inclusion. DoseAssessment records where a numeric dose lies relative to the statistics reported for its taxon." ;
    skos:related onsir:DoseAssessment .

onsir:hasDoseCategory a owl:ObjectProperty ;
    rdfs:label "has dose category"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:DoseCategory .

onsir:hasTreatment a owl:ObjectProperty ;
    rdfs:label "has treatment"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:SeedIrradiationTreatment .

onsir:taxon_Nicotiana_tabacum a obo:NCBITaxon_4097,
        owl:NamedIndividual ;
    rdfs:label "Nicotiana tabacum" .

obo:BFO_0000040 a owl:Class .

onsir:AtOrAboveReportedLD50 a owl:Class ;
    rdfs:label "at or above reported LD50"@en ;
    rdfs:subClassOf onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose reaches or exceeds the LD50 reported for its taxon. The LD50 is a 50 % lethality statistic for one endpoint and scoring time." .

onsir:BiochemicalChange a owl:Class ;
    rdfs:label "biochemical change"@en ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:definition "A biochemical characteristic measured after irradiation, such as the balance of reactive oxygen species, antioxidant content or an enzyme activity; the direction of the change is a result." .

onsir:DoseCategory a owl:Class ;
    rdfs:label "dose category"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) ] ;
    skos:definition "A qualitative classification of an irradiation dose by its predominant biological effect." .

onsir:LifecycleStage a owl:Class ;
    rdfs:label "life-cycle stage"@en .

onsir:PlantPart a owl:Class ;
    rdfs:label "plant part"@en ;
    rdfs:subClassOf obo:BFO_0000040,
        obo:PO_0025131 .

onsir:SterilizationResponse a owl:Class ;
    rdfs:label "sterilization response"@en ;
    rdfs:subClassOf onsir:Response .

onsir:MutagenicResponse a owl:Class ;
    rdfs:label "mutagenic response"@en ;
    rdfs:subClassOf onsir:Response .

onsir:QuantityValue a owl:Class ;
    rdfs:label "quantity value"@en ;
    rdfs:comment "dose rate values carry a typed qudt:hasUnit link; the unit asserted is gray per hour",
        "dose values carry a typed qudt:hasUnit link; absorbed dose is in gray" ;
    owl:equivalentClass qudt:QuantityValue ;
    skos:definition "A measured quantity with a numeric value and a typed unit (absorbed dose in gray, dose rate in gray per hour or per minute)." .

onsir:Context a owl:Class ;
    rdfs:label "context"@en ;
    rdfs:comment "Experimental or environmental conditions relevant to outcomes."@en .

onsir:Isotope a owl:Class ;
    rdfs:label "radioisotope"@en .

onsir:doseGy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dose in gray"@en ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal xsd:double ) ] ;
    skos:definition "absorbed dose, expressed in gray" .

onsir:forTaxon a owl:ObjectProperty ;
    rdfs:label "for taxon"@en ;
    rdfs:comment "the taxon the assessment is relative to" ;
    rdfs:domain onsir:DoseAssessment .

onsir:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:Response .

onsir:DoseResponseModel a owl:Class ;
    rdfs:label "dose–response model"@en ;
    skos:definition "A parametric model describing how an endpoint varies with dose (e.g., the Brain-Cousens hormetic model)." .

onsir:EndpointCategory a owl:Class ;
    rdfs:label "endpoint category"@en ;
    skos:definition "A coarse grouping of measured endpoints, as recorded by the coding scheme of a study corpus. Distinct from Endpoint, which names an individual measurable characteristic." .

onsir:Response a owl:Class ;
    rdfs:label "response"@en ;
    rdfs:subClassOf obo:BFO_0000015 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticResponse onsir:MutagenicResponse onsir:SterilizationResponse ) ] ;
    skos:relatedMatch obo:TO_0000161 .

qudt:QuantityValue a owl:Class .

onsir:HormeticResponse a owl:Class ;
    rdfs:label "hormetic response"@en ;
    rdfs:subClassOf onsir:Response ;
    skos:definition "A beneficial, stimulatory response to low-dose irradiation (e.g., enhanced germination, vigour, or stress resistance)." .

onsir:RadiationType a owl:Class ;
    rdfs:label "radiation type"@en .

onsir:TreatmentOutcome a owl:Class ;
    rdfs:label "treatment outcome"@en ;
    rdfs:comment "Reifies the relationship between treatment, subject, endpoint, context, and response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasTreatment ;
            owl:someValuesFrom onsir:SeedIrradiationTreatment ],
        [ a owl:Restriction ;
            owl:onClass onsir:SeedIrradiationTreatment ;
            owl:onProperty onsir:hasTreatment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:Response ] ;
    skos:definition "The observed result of a seed-irradiation treatment on a subject plant structure under a context, recorded with its response, endpoint or endpoint category." .

onsir:SeedIrradiationTreatment a owl:Class ;
    rdfs:label "seed irradiation treatment"@en ;
    rdfs:comment "Irradiation applied to seeds using ionizing or non-ionizing radiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:RadiationType ],
        [ a owl:Restriction ;
            owl:onProperty onsir:induces ;
            owl:someValuesFrom onsir:Response ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasDose ;
            owl:someValuesFrom onsir:QuantityValue ],
        [ a owl:Restriction ;
            owl:onClass onsir:QuantityValue ;
            owl:onProperty onsir:hasDose ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        obo:BFO_0000015,
        onsir:SeedTreatment ;
    skos:broadMatch obo:PECO_0007151 ;
    skos:definition "A treatment process in which seeds or other propagules are exposed to radiation of a specified type, source, dose and dose rate." .

onsir:Endpoint a owl:Class ;
    rdfs:label "endpoint"@en ;
    rdfs:comment "Measured response variable used to assess treatment effects."@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A measurable characteristic used to quantify an irradiation outcome (e.g., germination rate, root length, mutation frequency)." .

onsir:DoseAssessment a owl:Class ;
    rdfs:label "dose assessment"@en ;
    skos:definition "A numeric absorbed dose considered for a given taxon, endpoint and stage; the unit of taxon-relative dose positioning." .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticResponse onsir:MutagenicResponse onsir:SterilizationResponse ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:MutagenicResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:MutagenicDose ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:BelowReportedFavourableBand onsir:WithinReportedFavourableBand onsir:AboveReportedFavourableBand ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:EmergenceAndEarlyVigor onsir:BiochemicalEndpointCategory onsir:GeneticEndpointCategory onsir:MorphologicalEndpointCategory onsir:PlantHealthEndpointCategory onsir:OtherPhysiologicalEndpointCategory ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Gamma onsir:XRay onsir:Neutron onsir:Proton onsir:ElectronBeam onsir:UV_A onsir:UV_B onsir:UV_C ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:BelowReportedLD50 onsir:AtOrAboveReportedLD50 ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:HormeticResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:HormeticDose ] ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:LowDoseRate onsir:HighDoseRate ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Am241 onsir:Co60 onsir:Cs137 onsir:Ir192 onsir:Xe133 ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:SterilizationResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:SterilizationDose ] ) .

