                        owl:hasValue onsir:taxon_Vigna_unguiculata ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 80.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 8e+01 ] ) ] ) ] ] ) ] .

onsir:WaterQuality a owl:Class ;
    rdfs:label "Water Quality"@en ;
    rdfs:subClassOf onsir:Context ;
    skos:closeMatch obo:CHEBI_15377 .

onsir:atStage a owl:ObjectProperty ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range onsir:LifecycleStage .

onsir:bc_b a owl:DatatypeProperty ;
    rdfs:label "BC parameter b"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_c a owl:DatatypeProperty ;
    rdfs:label "BC parameter c"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_d a owl:DatatypeProperty ;
    rdfs:label "BC parameter d"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_e a owl:DatatypeProperty ;
    rdfs:label "BC parameter e"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:bc_f a owl:DatatypeProperty ;
    rdfs:label "BC parameter f"@en ;
    rdfs:domain onsir:DoseResponseModel ;
    rdfs:range xsd:double .

onsir:doseLowerGy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "lower dose bound in gray" ;
    rdfs:domain onsir:DoseRange ;
    rdfs:range xsd:double .

onsir:doseUpperGy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:comment "upper dose bound in gray" ;
    rdfs:domain onsir:DoseRange ;
    rdfs:range xsd:double .

onsir:forEndpoint a owl:ObjectProperty ;
    rdfs:label "for endpoint"@en ;
    rdfs:domain onsir:DoseAssessment,
        onsir:TreatmentOutcome ;
    rdfs:range onsir:Endpoint .

onsir:germinationRateIncrease a owl:DatatypeProperty ;
    rdfs:label "germination rate increase"@en ;
    rdfs:domain onsir:HormeticResponse ;
    rdfs:range xsd:double .

onsir:hasBiochemicalChange a owl:ObjectProperty ;
    rdfs:label "has biochemical change"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:BiochemicalChange ;
    rdfs:subPropertyOf onsir:induces .

onsir:hasContext a owl:ObjectProperty ;
    rdfs:label "has context"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:Context .

onsir:hasDoseRange a owl:ObjectProperty ;
    rdfs:label "has dose range"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:DoseRange .

onsir:hasDoseRate a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has dose rate"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:hasDoseRateCategory a owl:ObjectProperty ;
    rdfs:label "has dose-rate category"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:DoseRateCategory .

onsir:hasExposureTime a owl:ObjectProperty ;
    rdfs:label "has exposure time"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:hasFluence a owl:ObjectProperty ;
    rdfs:label "has fluence"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:hasModel a owl:ObjectProperty ;
    rdfs:label "has model"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:DoseResponseModel .

onsir:hasSourceIsotope a owl:ObjectProperty ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:Isotope .

onsir:hasSubject a owl:ObjectProperty ;
    rdfs:label "has subject"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:PlantSeed .

onsir:hasTaxon a owl:ObjectProperty ;
    rdfs:comment "relates a plant structure to its taxon; taxonomic identity is not an anatomical type, so PlantSeed is never asserted to be a subclass of an NCBITaxon class" ;
    rdfs:domain onsir:PlantSeed .

onsir:hasWavelength a owl:ObjectProperty ;
    rdfs:label "has wavelength"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:inducedBy a owl:ObjectProperty ;
    owl:inverseOf onsir:induces .

onsir:isTreatmentOf a owl:ObjectProperty ;
    owl:inverseOf onsir:hasTreatment .

onsir:mutationFrequency a owl:DatatypeProperty ;
    rdfs:label "mutation frequency"@en ;
    rdfs:domain onsir:MutagenicResponse ;
    rdfs:range xsd:double .

onsir:numericValue a owl:FunctionalProperty .

onsir:rootGrowthStimulus a owl:DatatypeProperty ;
    rdfs:label "root growth stimulus"@en ;
    rdfs:domain onsir:HormeticResponse ;
    rdfs:range xsd:double .

onsir:sterilityRate a owl:DatatypeProperty ;
    rdfs:label "sterility rate"@en ;
    rdfs:domain onsir:SterilizationResponse ;
    rdfs:range xsd:double .

onsir:Am241 a owl:Class ;
    rdfs:label "Am241"@en ;
    rdfs:subClassOf onsir:Isotope .

onsir:BrainCousensModel a owl:Class ;
    rdfs:label "Brain–Cousens Model"@en ;
    rdfs:subClassOf onsir:DoseResponseModel .

onsir:Co60 a owl:Class ;
    rdfs:label "Co60"@en ;
    rdfs:subClassOf onsir:Isotope ;
    skos:closeMatch obo:CHEBI_749374 .

onsir:Cs137 a owl:Class ;
    rdfs:label "Cs137"@en ;
    rdfs:subClassOf onsir:Isotope ;
    owl:equivalentClass obo:CHEBI_196959 .

onsir:ElectronBeam a owl:Class ;
    rdfs:label "ElectronBeam"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:Gamma a owl:Class ;
    rdfs:label "Gamma"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:GerminationRate a owl:Class ;
    rdfs:label "GerminationRate"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:HighDoseRate a owl:Class ;
    rdfs:label "High Dose-rate"@en ;
    rdfs:subClassOf onsir:DoseRateCategory .

onsir:Ir192 a owl:Class ;
    rdfs:label "Ir192"@en ;
    rdfs:subClassOf onsir:Isotope .

onsir:LowDoseRate a owl:Class ;
    rdfs:label "Low Dose-rate"@en ;
    rdfs:subClassOf onsir:DoseRateCategory .

onsir:Model_BC_Germination a onsir:BrainCousensModel ;
    onsir:bc_b -2.148e+00 ;
    onsir:bc_c 1.017e-03 ;
    onsir:bc_d 2.433e-03 ;
    onsir:bc_e 5.3e+01 ;
    onsir:bc_f -3.747e-06 .

onsir:MutagenicDoseRange a owl:Class ;
    rdfs:label "Mutagenic Dose Range"@en ;
    rdfs:subClassOf onsir:DoseRange .

onsir:MutationFrequency a owl:Class ;
    rdfs:label "MutationFrequency"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:Neutron a owl:Class ;
    rdfs:label "Neutron"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:Proton a owl:Class ;
    rdfs:label "Proton"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:Resp_GerminationHormesis a onsir:HormeticResponse ;
    onsir:germinationRateIncrease 2.2e-01 ;
    onsir:rootGrowthStimulus 3e-01 .

onsir:Resp_Mutagenesis a onsir:MutagenicResponse ;
    onsir:mutationFrequency 1.2e-02 .

onsir:Resp_Sterility a onsir:SterilizationResponse ;
    onsir:sterilityRate 9.8e-01 .

onsir:SeedSterility a owl:Class ;
    rdfs:label "SeedSterility"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:SeedTreatment a owl:Class ;
    rdfs:label "Seed Treatment"@en ;
    rdfs:comment "Any pre-sowing treatment applied to seeds."@en ;
    rdfs:subClassOf obo:BFO_0000015 .

onsir:SterilizationDoseRange a owl:Class ;
    rdfs:label "Sterilization Dose Range"@en ;
    rdfs:subClassOf onsir:DoseRange .

onsir:Treat_Co60_Gamma_50Gy a onsir:SeedIrradiationTreatment ;
    onsir:hasDose [ a qudt:QuantityValue ;
            qudt:numericValue 5e+01 ;
            qudt:unit <http://qudt.org/vocab/unit/Gray> ] ;
    onsir:hasDoseRange [ a onsir:BeneficialDoseRange ;
            onsir:maxDose [ a qudt:QuantityValue ;
                    qudt:numericValue 1e+02 ;
                    qudt:unit <http://qudt.org/vocab/unit/Gray> ] ;
            onsir:minDose [ a qudt:QuantityValue ;
                    qudt:numericValue 2.5e+01 ;
                    qudt:unit <http://qudt.org/vocab/unit/Gray> ] ] ;
    onsir:hasDoseRate [ a qudt:QuantityValue ;
            qudt:numericValue 2.5e+00 ;
            qudt:unit <http://qudt.org/vocab/unit/Gy-PER-HR> ] ;
    onsir:hasExposureTime [ a qudt:QuantityValue ;
            qudt:numericValue 3.33333e-01 ;
            qudt:unit <http://qudt.org/vocab/unit/HR> ] ;
    onsir:radiationType "gamma" ;
    onsir:sourceIsotope "Co-60" .

onsir:Treat_UVC_254nm_1200Jm2 a onsir:SeedIrradiationTreatment ;
    onsir:hasFluence [ a qudt:QuantityValue ;
            qudt:numericValue 1.2e+03 ;
            qudt:unit <http://qudt.org/vocab/unit/J-PER-M2> ] ;
    onsir:hasWavelength [ a qudt:QuantityValue ;
            qudt:numericValue 2.54e+02 ;
            qudt:unit <http://qudt.org/vocab/unit/NanoM> ] ;
    onsir:radiationType "uv-c" .

onsir:Treat_XRay_150Gy a onsir:SeedIrradiationTreatment ;
    onsir:hasDose [ a qudt:QuantityValue ;
            qudt:numericValue 1.5e+02 ;
            qudt:unit <http://qudt.org/vocab/unit/Gray> ] ;
    onsir:radiationType "x-ray" .

onsir:UV_A a owl:Class ;
    rdfs:label "UV_A"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:UV_B a owl:Class ;
    rdfs:label "UV_B"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:UV_C a owl:Class ;
    rdfs:label "UV_C"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:XRay a owl:Class ;
    rdfs:label "XRay"@en ;
    rdfs:subClassOf onsir:RadiationType .

onsir:Xe133 a owl:Class ;
    rdfs:label "Xe133"@en ;
    rdfs:subClassOf onsir:Isotope .

onsir:hasRadiationType a owl:ObjectProperty ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:RadiationType .

onsir:maxDose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "max dose"@en ;
    rdfs:domain onsir:DoseRange ;
    rdfs:range qudt:QuantityValue .

onsir:minDose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "min dose"@en ;
    rdfs:domain onsir:DoseRange ;
    rdfs:range qudt:QuantityValue .

onsir:BeneficialDoseRange a owl:Class ;
    rdfs:label "Beneficial Dose Range"@en ;
    rdfs:subClassOf onsir:DoseRange .

onsir:StressResistance a owl:Class ;
    rdfs:label "Stress Resistance"@en ;
    rdfs:subClassOf onsir:HormeticResponse .

onsir:hasDose a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has absorbed dose"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range qudt:QuantityValue .

onsir:DoseRateCategory a owl:Class ;
    rdfs:label "Dose-rate Category"@en .

onsir:expectedResponse a owl:ObjectProperty ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range onsir:Response .

onsir:hasDoseCategory a owl:ObjectProperty ;
    rdfs:label "has dose category"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:DoseCategory .

onsir:hasTreatment a owl:ObjectProperty ;
    rdfs:label "has treatment"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:SeedIrradiationTreatment .

onsir:induces a owl:ObjectProperty ;
    rdfs:label "induces"@en ;
    rdfs:domain onsir:SeedIrradiationTreatment ;
    rdfs:range onsir:Response .

onsir:taxon_Capsicum_annuum a obo:NCBITaxon_4072,
        owl:NamedIndividual ;
    rdfs:label "Capsicum annuum" .

onsir:taxon_Nicotiana_tabacum a obo:NCBITaxon_4097,
        owl:NamedIndividual ;
    rdfs:label "Nicotiana tabacum" .

onsir:taxon_Trigonella_foenum_graecum a obo:NCBITaxon_78534,
        owl:NamedIndividual ;
    rdfs:label "Trigonella foenum-graecum" .

onsir:taxon_Vigna_unguiculata a obo:NCBITaxon_3917,
        owl:NamedIndividual ;
    rdfs:label "Vigna unguiculata" .

onsir:BiochemicalChange a owl:Class ;
    rdfs:label "Biochemical Change"@en ;
    rdfs:subClassOf onsir:HormeticResponse .

onsir:DoseCategory a owl:Class ;
    rdfs:label "Dose Category"@en ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) ] ;
    skos:definition "A qualitative classification of an irradiation dose by its predominant biological effect." .

onsir:HormeticDose a owl:Class ;
    rdfs:label "Hormetic Dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose in the range that elicits a stimulatory (hormetic) biological response." .

onsir:LifecycleStage a owl:Class ;
    rdfs:label "Lifecycle Stage"@en ;
    rdfs:comment "Integration touchpoint: map Seed/Germination/Seedling stages to external lifecycle hierarchies."@en .

onsir:MutagenicDose a owl:Class ;
    rdfs:label "Mutagenic Dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose in the range that elicits induced genetic variability (mutagenesis) without predominant sterilization." .

onsir:QuantityValue rdfs:comment "dose rate values use gray per minute (UO_0010060)",
        "dose values use unit gray (UO_0000134)" ;
    skos:definition "A measured quantity with a numeric value and a unit (dose in gray, dose rate in gray per minute)." .

onsir:SterilizationDose a owl:Class ;
    rdfs:label "Sterilization Dose"@en ;
    rdfs:subClassOf onsir:DoseCategory ;
    skos:definition "A dose high enough to cause predominant loss of viability or reproductive capacity." .

onsir:MutagenicDoseAssessment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:expectedResponse ;
            owl:someValuesFrom onsir:MutagenicResponse ],
        onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose lies between the stimulatory optimum and the early-viability LD50 of its taxon." .

onsir:PlantSeed a owl:Class ;
    rdfs:label "Plant Seed"@en ;
    rdfs:comment "Integration touchpoint suggestion: align to crop ontologies' seed class (e.g., TobaccoSeed) via skos:exactMatch/closeMatch."@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass obo:PO_0009010 .

onsir:SterilizingDoseAssessment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:expectedResponse ;
            owl:someValuesFrom onsir:SterilizationResponse ],
        onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose reaches or exceeds the early-viability LD50 of its taxon." .

onsir:StimulatoryDoseAssessment a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:expectedResponse ;
            owl:someValuesFrom onsir:HormeticResponse ],
        onsir:DoseAssessment ;
    skos:definition "A DoseAssessment whose dose lies in the stimulatory window of its taxon." .

onsir:Context a owl:Class ;
    rdfs:label "Context"@en ;
    rdfs:comment "Experimental or environmental conditions relevant to outcomes."@en .

onsir:Isotope a owl:Class ;
    rdfs:label "Radioisotope"@en .

onsir:SterilizationResponse a owl:Class ;
    rdfs:label "Sterilization Response"@en ;
    rdfs:subClassOf onsir:Response .

onsir:hasResponse a owl:ObjectProperty ;
    rdfs:label "has response"@en ;
    rdfs:domain onsir:TreatmentOutcome ;
    rdfs:range onsir:Response .

onsir:DoseResponseModel a owl:Class ;
    rdfs:label "Dose–Response Model"@en ;
    skos:definition "A parametric model describing how an endpoint varies with dose (e.g., the Brain-Cousens hormetic model)." .

onsir:MutagenicResponse a owl:Class ;
    rdfs:label "Mutagenic Response"@en ;
    rdfs:subClassOf onsir:Response .

onsir:DoseRange a owl:Class ;
    rdfs:label "Dose Range"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:maxDose ;
            owl:someValuesFrom onsir:QuantityValue ],
        [ a owl:Restriction ;
            owl:onProperty onsir:minDose ;
            owl:someValuesFrom onsir:QuantityValue ] .

onsir:Response a owl:Class ;
    rdfs:label "Response"@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( onsir:HormeticResponse onsir:MutagenicResponse onsir:SterilizationResponse ) ] .

onsir:HormeticResponse a owl:Class ;
    rdfs:label "Hormetic Response"@en ;
    rdfs:subClassOf onsir:Response ;
    skos:definition "A beneficial, stimulatory response to low-dose irradiation (e.g., enhanced germination, vigour, or stress resistance)." .

onsir:RadiationType a owl:Class ;
    rdfs:label "Radiation Type"@en .

onsir:doseGy a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:domain onsir:DoseAssessment ;
    rdfs:range [ a rdfs:Datatype ;
            owl:unionOf ( xsd:decimal xsd:double ) ] ;
    skos:definition "absorbed dose in gray (UO_0000134)" .

onsir:forTaxon a owl:ObjectProperty ;
    rdfs:comment "the taxon the assessment is relative to" ;
    rdfs:domain onsir:DoseAssessment .

onsir:Endpoint a owl:Class ;
    rdfs:label "Endpoint"@en ;
    rdfs:comment "Measured response variable used to assess treatment effects."@en ;
    rdfs:subClassOf obo:BFO_0000019 ;
    skos:definition "A measurable characteristic used to quantify an irradiation outcome (e.g., germination rate, root length, mutation frequency)." .

qudt:QuantityValue a owl:Class .

onsir:SeedIrradiationTreatment a owl:Class ;
    rdfs:label "Seed Irradiation Treatment"@en ;
    rdfs:comment "Integration touchpoint suggestion: align to external ontology class 'SeedTreatment' via skos:closeMatch."@en,
        "Irradiation applied to seeds using ionizing or non-ionizing radiation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasRadiationType ;
            owl:someValuesFrom onsir:RadiationType ],
        [ a owl:Restriction ;
            owl:onClass onsir:QuantityValue ;
            owl:onProperty onsir:hasDose ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasDose ;
            owl:someValuesFrom onsir:QuantityValue ],
        [ a owl:Restriction ;
            owl:onProperty onsir:induces ;
            owl:someValuesFrom onsir:Response ],
        obo:BFO_0000015,
        onsir:SeedTreatment ;
    skos:definition "A treatment process in which seeds are exposed to ionizing radiation of a specified type, source, dose and dose rate." .

onsir:TreatmentOutcome a owl:Class ;
    rdfs:label "Treatment Outcome"@en ;
    rdfs:comment "Reifies the relationship between treatment, subject, endpoint, context, and response."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasTreatment ;
            owl:someValuesFrom onsir:SeedIrradiationTreatment ],
        [ a owl:Restriction ;
            owl:onClass onsir:SeedIrradiationTreatment ;
            owl:onProperty onsir:hasTreatment ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:Response ] ;
    skos:definition "The observed result of a seed-irradiation treatment on a subject seed under a context, characterized by a dose category and a biological response for a given endpoint." .

onsir:DoseAssessment a owl:Class ;
    skos:definition "A numeric absorbed dose considered for a given taxon, endpoint and stage; the unit of context-dependent dose classification." .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:StimulatoryDoseAssessment onsir:MutagenicDoseAssessment onsir:SterilizingDoseAssessment ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticDose onsir:MutagenicDose onsir:SterilizationDose ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:HormeticResponse onsir:MutagenicResponse onsir:SterilizationResponse ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Gamma onsir:XRay onsir:Neutron onsir:Proton onsir:ElectronBeam onsir:UV_A onsir:UV_B onsir:UV_C ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:Am241 onsir:Co60 onsir:Cs137 onsir:Ir192 onsir:Xe133 ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:BeneficialDoseRange onsir:MutagenicDoseRange onsir:SterilizationDoseRange ) .

[] a owl:AllDisjointClasses ;
    owl:members ( onsir:LowDoseRate onsir:HighDoseRate ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:HormeticResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:HormeticDose ] ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:SterilizationResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:SterilizationDose ] ) .

[] a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty onsir:hasResponse ;
            owl:someValuesFrom onsir:MutagenicResponse ] ;
    owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                owl:onProperty onsir:hasDoseCategory ;
                owl:someValuesFrom onsir:MutagenicDose ] ) .

