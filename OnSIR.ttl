    rdfs:comment "sterilizing dose window for Vigna unguiculata: bounds from Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33" ;
    rdfs:subClassOf onsir:SterilizingDoseAssessment ;
