onsir:Trigonella_foenum_graecum_BelowLD50Dose a owl:Class ;
    rdfs:label "Trigonella foenum-graecum below LD50 dose"@en ;
    dct:source "Patel et al. 2017, J. AgriSearch 4(4):237-241, doi:10.21921/jas.v4i04.10200" ;
    rdfs:comment "Dose window for Trigonella foenum-graecum, bounded by the statistics its source reports." ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Trigonella_foenum_graecum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 350.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxExclusive 3.5e+02 ] ) ] ) ] ] ) ] ;
    skos:scopeNote "The source irradiated doses from 150 to 350 Gy; where the window extends past them, the position is arithmetic only." ;
    onsir:boundQualifier "The source states that the LD50 is close to 350 Gy, its highest dose, at which 64 % of seeds germinated and 56 % of seedlings survived, against 96 % and 90 % in the control. 350 Gy is encoded as a lower bound on the LD50, so only the window below it is defined." .

onsir:Vigna_unguiculata_AtOrAboveLD50Dose a owl:Class ;
    rdfs:label "Vigna unguiculata at or above LD50 dose"@en ;
    dct:source "Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33, doi:10.5897/IJGMB2019.0174" ;
    rdfs:comment "Dose window for Vigna unguiculata, bounded by the statistics its source reports." ;
    rdfs:subClassOf onsir:AtOrAboveReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Vigna_unguiculata ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 132.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 1.32e+02 ] ) ] ) ] ] ) ] ;
    skos:scopeNote "The source irradiated doses from 150 to 300 Gy; where the window extends past them, the position is arithmetic only." ;
    onsir:boundQualifier "Median of three genotype survival LD50s (129.8, 132.0, 150.2 Gy), each from a straight line fitted to survival at 50 % flowering relative to the control; observed survival at 150 Gy, the lowest dose tested, was 56 to 71 % and at 250 Gy zero, so the observations place two of the LD50s between 150 and 200 Gy and the third, whose 200 Gy row prints 75.86 % in both the lethality and the survival column, between 150 and 250 Gy." .

onsir:Vigna_unguiculata_BelowLD50Dose a owl:Class ;
    rdfs:label "Vigna unguiculata below LD50 dose"@en ;
    dct:source "Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33, doi:10.5897/IJGMB2019.0174" ;
    rdfs:comment "Dose window for Vigna unguiculata, bounded by the statistics its source reports." ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Vigna_unguiculata ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 132.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxExclusive 1.32e+02 ] ) ] ) ] ] ) ] ;
    skos:scopeNote "The source irradiated doses from 150 to 300 Gy; where the window extends past them, the position is arithmetic only." ;
    onsir:boundQualifier "Median of three genotype survival LD50s (129.8, 132.0, 150.2 Gy), each from a straight line fitted to survival at 50 % flowering relative to the control; observed survival at 150 Gy, the lowest dose tested, was 56 to 71 % and at 250 Gy zero, so the observations place two of the LD50s between 150 and 200 Gy and the third, whose 200 Gy row prints 75.86 % in both the lethality and the survival column, between 150 and 250 Gy." .

