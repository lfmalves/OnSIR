onsir:Trigonella_foenum_graecum_SeedlingSurvival_BelowLD50Dose a owl:Class ;
    rdfs:label "Trigonella foenum-graecum seedling survival below LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Trigonella foenum-graecum for seedling survival in the early seedling stage, at a dose of 350 Gy or less; at 350 Gy, the highest dose of Patel et al. (2017), 56 % of seedlings survived." ;
    dct:source "Patel et al. 2017, J. AgriSearch 4(4):237-241, doi:10.21921/jas.v4i04.10200" ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_78534 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:EarlySeedlingStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 350.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 3.5e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Trigonella foenum-graecum for seedling survival in the early seedling stage, at a dose of 350 Gy or less; at 350 Gy, the highest dose of Patel et al. (2017), 56 % of seedlings survived." ;
    skos:scopeNote "The source irradiated doses from 150 to 350 Gy and scored plants alive 30 days after sowing in Petri dishes, as a percentage of the seeds sown; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source states that the LD50 is close to 350 Gy, its highest dose, at which 64 % of seeds germinated and 56 % of seedlings survived, against 96 % and 90 % in the control. Survival above half at 350 Gy makes 350 Gy a lower bound on the LD50, so only the window below the LD50 is defined, and it includes 350 Gy." ;
    onsir:sourceStatement "The LD50 was closed to 350 on which 64 percent seed germination, 56% seedlings survival and a considerable reduction in seedlings growth were recorded." .

