<https://w3id.org/onsir> a owl:Ontology ;
    dct:bibliographicCitation "Alves LFM, de Franco Rosa F, Arthur V. OnSIR: Ontology for Seed Irradiation and Plant Radiobiology, version 1.7.0. https://w3id.org/onsir/1.7.0" ;
    dct:created "2025-09-21"^^xsd:date ;
    dct:creator <https://orcid.org/0000-0001-9504-496X>,
        <https://orcid.org/0000-0003-3521-9136>,
        <https://orcid.org/0009-0005-4227-5568> ;
    dct:description "An OWL 2 DL ontology of seed-irradiation treatments and their dose-dependent biological effects, with dose-to-effect axioms and taxon dose windows, conditioned on endpoint and stage, for description-logic reasoning. Its classes are aligned, with IRIs checked against the EBI Ontology Lookup Service, to BFO, IAO, OBI, PO, NCBITaxon, ChEBI, GO, PATO, PECO and TO, taxa are stated with the RO relation in taxon, and its units are QUDT terms." ;
    dct:issued "2026-10-05"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-10-05"^^xsd:date ;
    dct:publisher <https://orcid.org/0009-0005-4227-5568> ;
    dct:source <https://doi.org/10.22456/2175-2745.146658>,
        <https://doi.org/10.56238/sevened2025.039-003>,
        <https://doi.org/10.69547/TSFJB.030203> ;
    dct:title "OnSIR: Ontology for Seed Irradiation and Plant Radiobiology" ;
    vann:preferredNamespacePrefix "onsir" ;
    vann:preferredNamespaceUri "https://w3id.org/onsir/"^^xsd:anyURI ;
    rdfs:comment "Canonical IRI https://w3id.org/onsir; source at https://github.com/lfmalves/OnSIR" ;
    rdfs:seeAlso obo:rbo.owl ;
    owl:priorVersion onsir:1.6.0 ;
    owl:versionIRI onsir:1.7.0 ;
    owl:versionInfo "1.7.0" .

onsir:AbioticStressResistance a owl:Class ;
    rdfs:label "abiotic stress resistance"@en ;
    obo:IAO_0000115 "Stress resistance under an abiotic stress, such as salinity, drought or an extreme temperature." ;
    rdfs:subClassOf onsir:StressResistance ;
    skos:closeMatch obo:TO_0000168 ;
    skos:definition "Stress resistance under an abiotic stress, such as salinity, drought or an extreme temperature." .

onsir:AntioxidantActivity a owl:Class ;
    rdfs:label "antioxidant activity"@en ;
    obo:IAO_0000115 "The capacity of a tissue extract to scavenge free radicals or reactive oxygen species, measured in an assay such as DPPH radical scavenging." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0001143 ;
    skos:definition "The capacity of a tissue extract to scavenge free radicals or reactive oxygen species, measured in an assay such as DPPH radical scavenging." ;
    skos:relatedMatch obo:GO_0016209 .

onsir:AntioxidantIncrease a owl:Class ;
    rdfs:label "antioxidant increase"@en ;
    obo:IAO_0000115 "An increase in antioxidant content or antioxidant enzyme activity measured after irradiation, relative to the unirradiated control." ;
    rdfs:subClassOf onsir:BiochemicalChange ;
    skos:broadMatch obo:TO_0001143 ;
    skos:definition "An increase in antioxidant content or antioxidant enzyme activity measured after irradiation, relative to the unirradiated control." .

onsir:BioticStressResistance a owl:Class ;
    rdfs:label "biotic stress resistance"@en ;
    obo:IAO_0000115 "Stress resistance under a biotic stress, such as a pathogen or a pest." ;
    rdfs:subClassOf onsir:StressResistance ;
    skos:closeMatch obo:TO_0000179 ;
    skos:definition "Stress resistance under a biotic stress, such as a pathogen or a pest." .

onsir:BrainCousensModel a owl:Class ;
    rdfs:label "Brain–Cousens model"@en ;
    obo:IAO_0000115 "The dose-response model of Brain and Cousens: an equation for dose responses with stimulation at low doses, which contains the common sigmoidal (log-logistic) curve as a special case." ;
    obo:IAO_0000119 "Brain P, Cousens R (1989). An equation to describe dose responses where there is stimulation of growth at low doses. Weed Research 29:93-96, doi:10.1111/j.1365-3180.1989.tb00845.x" ;
    rdfs:subClassOf onsir:DoseResponseModel ;
    skos:definition "The dose-response model of Brain and Cousens: an equation for dose responses with stimulation at low doses, which contains the common sigmoidal (log-logistic) curve as a special case." .

onsir:ChlorophyllContent a owl:Class ;
    rdfs:label "chlorophyll content"@en ;
    obo:IAO_0000115 "The amount of chlorophyll in leaf or seedling tissue, per unit mass or area." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0000495 ;
    skos:definition "The amount of chlorophyll in leaf or seedling tissue, per unit mass or area." .

onsir:DryMass a owl:Class ;
    rdfs:label "dry mass"@en ;
    obo:IAO_0000115 "The mass of a seedling, plant or organ after drying." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:broadMatch obo:PATO_0000125 ;
    skos:definition "The mass of a seedling, plant or organ after drying." .

onsir:EnzymeActivityChange a owl:Class ;
    rdfs:label "enzyme activity change"@en ;
    obo:IAO_0000115 "A change in the activity of an enzyme measured after irradiation, relative to the unirradiated control." ;
    rdfs:subClassOf onsir:BiochemicalChange ;
    skos:broadMatch obo:TO_0000599 ;
    skos:definition "A change in the activity of an enzyme measured after irradiation, relative to the unirradiated control." .

onsir:HighDoseRate a owl:Class ;
    rdfs:label "obsolete high dose rate"@en ;
    obo:IAO_0000115 "OBSOLETE. A reported dose rate above 100 Gy per hour. Renamed after the bound that defines it." ;
    obo:IAO_0100001 onsir:DoseRateAbove100GyPerHour ;
    owl:deprecated true ;
    skos:definition "OBSOLETE. A reported dose rate above 100 Gy per hour. Renamed after the bound that defines it." .

onsir:Lablab_purpureus_Germination_AtOrAboveLD50Dose a owl:Class ;
    rdfs:label "Lablab purpureus germination at or above LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Lablab purpureus for germination, at a dose of 304.1 Gy or more, at or above both probit estimates of the LD50 of Mahesha et al. (2023) and the 30 kR they adopt." ;
    dct:source "Mahesha et al. 2023, Environ. Ecol. 41(4C):2838-2844, doi:10.60151/envec/EFHD5757" ;
    rdfs:subClassOf onsir:AtOrAboveReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_35936 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:GerminationPercentage ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:GerminationStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 304.1 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 3.041e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Lablab purpureus for germination, at a dose of 304.1 Gy or more, at or above both probit estimates of the LD50 of Mahesha et al. (2023) and the 30 kR they adopt." ;
    skos:scopeNote "The source irradiated doses from 87.7 to 526.2 Gy and scored germination seven days after sowing, in Petri plates and in polybags; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source reports probit estimates of 34.67 kR in Petri plates and 33.11 kR in polybags and adopts 30 kR as the LD50 in its abstract and methods; at 8.77 mGy per roentgen (air kerma) these are 304.1, 290.4 and 263.1 Gy. The window below the LD50 ends below 263.1 Gy and the window at or above it starts at 304.1 Gy; doses between them fall in no window." ;
    onsir:sourceStatement "Probit analysis revealed that the LD50 value was 30kR. [...] Based on the percentage of germination both in petri plates and polybags, the LD50 value was calculated using probit analysis, which observed probit values being 34.67kR and 33.11kR, respectively" .

onsir:Lablab_purpureus_Germination_BelowLD50Dose a owl:Class ;
    rdfs:label "Lablab purpureus germination below LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Lablab purpureus for germination, at a dose below 263.1 Gy (30 kR), the LD50 that Mahesha et al. (2023) adopt, and below both of their probit estimates." ;
    dct:source "Mahesha et al. 2023, Environ. Ecol. 41(4C):2838-2844, doi:10.60151/envec/EFHD5757" ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_35936 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:GerminationPercentage ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:GerminationStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 263.1 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxExclusive 2.631e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Lablab purpureus for germination, at a dose below 263.1 Gy (30 kR), the LD50 that Mahesha et al. (2023) adopt, and below both of their probit estimates." ;
    skos:scopeNote "The source irradiated doses from 87.7 to 526.2 Gy and scored germination seven days after sowing, in Petri plates and in polybags; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source reports probit estimates of 34.67 kR in Petri plates and 33.11 kR in polybags and adopts 30 kR as the LD50 in its abstract and methods; at 8.77 mGy per roentgen (air kerma) these are 304.1, 290.4 and 263.1 Gy. The window below the LD50 ends below 263.1 Gy and the window at or above it starts at 304.1 Gy; doses between them fall in no window." ;
    onsir:sourceStatement "Probit analysis revealed that the LD50 value was 30kR. [...] Based on the percentage of germination both in petri plates and polybags, the LD50 value was calculated using probit analysis, which observed probit values being 34.67kR and 33.11kR, respectively" .

onsir:LightCondition a owl:Class ;
    rdfs:label "light condition"@en ;
    obo:IAO_0000115 "The light under which seeds were germinated or plants grown: its intensity, quality or photoperiod." ;
    rdfs:subClassOf onsir:Context ;
    skos:definition "The light under which seeds were germinated or plants grown: its intensity, quality or photoperiod." ;
    skos:relatedMatch obo:PECO_0007224 .

onsir:LipidPeroxidation a owl:Class ;
    rdfs:label "lipid peroxidation"@en ;
    obo:IAO_0000115 "The extent of oxidative degradation of membrane lipids, usually measured as malondialdehyde content." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:broadMatch obo:GO_0034440 ;
    skos:definition "The extent of oxidative degradation of membrane lipids, usually measured as malondialdehyde content." .

onsir:LowDoseRate a owl:Class ;
    rdfs:label "obsolete low dose rate"@en ;
    obo:IAO_0000115 "OBSOLETE. A reported dose rate below 100 Gy per hour. Renamed after the bound that defines it." ;
    obo:IAO_0100001 onsir:DoseRateBelow100GyPerHour ;
    owl:deprecated true ;
    skos:definition "OBSOLETE. A reported dose rate below 100 Gy per hour. Renamed after the bound that defines it." .

onsir:Magnolia_champaca_Germination_AtOrAboveLD50Dose a owl:Class ;
    rdfs:label "Magnolia champaca germination at or above LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Magnolia champaca for germination, at a dose of 40 Gy or more, at or above the LD50 that Zanzibar and Sudrajat (2016) place between 30 and 40 Gy." ;
    dct:source "Zanzibar and Sudrajat 2016, Indones. J. For. Res. 3(2):95-106, doi:10.20886/ijfr.2016.3.2.95-106" ;
    rdfs:subClassOf onsir:AtOrAboveReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_86757 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:GerminationPercentage ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:GerminationStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 40.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 4e+01 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Magnolia champaca for germination, at a dose of 40 Gy or more, at or above the LD50 that Zanzibar and Sudrajat (2016) place between 30 and 40 Gy." ;
    skos:scopeNote "The source irradiated doses from 5 to 100 Gy and scored germination percentage of fresh seeds in a germination test, as lethality relative to the control; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source estimates the LD50 by regression of germination lethality relative to the control and places it above 30 Gy and below 40 Gy. Its observations agree: germination at 20 Gy was 65 % of the control and at 40 Gy 24 %." ;
    onsir:sourceStatement "Irradiation at dose higher than 30 Gy and below 40 Gy is considered being the lethal dosage (LD50) for M. champaca seeds" .

onsir:Magnolia_champaca_Germination_BelowLD50Dose a owl:Class ;
    rdfs:label "Magnolia champaca germination below LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Magnolia champaca for germination, at a dose below 30 Gy, below the LD50 that Zanzibar and Sudrajat (2016) place between 30 and 40 Gy." ;
    dct:source "Zanzibar and Sudrajat 2016, Indones. J. For. Res. 3(2):95-106, doi:10.20886/ijfr.2016.3.2.95-106" ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_86757 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:GerminationPercentage ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:GerminationStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 30.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxExclusive 3e+01 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Magnolia champaca for germination, at a dose below 30 Gy, below the LD50 that Zanzibar and Sudrajat (2016) place between 30 and 40 Gy." ;
    skos:scopeNote "The source irradiated doses from 5 to 100 Gy and scored germination percentage of fresh seeds in a germination test, as lethality relative to the control; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source estimates the LD50 by regression of germination lethality relative to the control and places it above 30 Gy and below 40 Gy. Its observations agree: germination at 20 Gy was 65 % of the control and at 40 Gy 24 %." ;
    onsir:sourceStatement "Irradiation at dose higher than 30 Gy and below 40 Gy is considered being the lethal dosage (LD50) for M. champaca seeds" .

onsir:MutagenicOutcome a owl:Class ;
    rdfs:label "mutagenic outcome"@en ;
    obo:IAO_0000115 "A treatment outcome that has a mutagenic response." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                        owl:onProperty onsir:hasResponse ;
                        owl:someValuesFrom onsir:MutagenicResponse ] ) ] ;
    skos:definition "A treatment outcome that has a mutagenic response." .

onsir:MutationFrequency a owl:Class ;
    rdfs:label "mutation frequency"@en ;
    obo:IAO_0000115 "The frequency of mutants, or of mutations, among the plants or progeny raised from irradiated propagules." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:definition "The frequency of mutants, or of mutations, among the plants or progeny raised from irradiated propagules." .

onsir:Nicotiana_tabacum_AboveFavourableBandDose a owl:Class ;
    rdfs:label "obsolete Nicotiana tabacum above favourable band dose"@en ;
    obo:IAO_0000115 "OBSOLETE. A dose window of release 1.6.0 for Nicotiana tabacum, conditioned on the taxon alone. Replaced by a window that is also conditioned on the endpoint and the stage its source scored." ;
    obo:IAO_0100001 onsir:Nicotiana_tabacum_SeedlingPerformance_AboveFavourableBandDose ;
    owl:deprecated true ;
    skos:definition "OBSOLETE. A dose window of release 1.6.0 for Nicotiana tabacum, conditioned on the taxon alone. Replaced by a window that is also conditioned on the endpoint and the stage its source scored." .

onsir:Nicotiana_tabacum_BelowFavourableBandDose a owl:Class ;
    rdfs:label "obsolete Nicotiana tabacum below favourable band dose"@en ;
    obo:IAO_0000115 "OBSOLETE. A dose window of release 1.6.0 for Nicotiana tabacum, conditioned on the taxon alone. Replaced by a window that is also conditioned on the endpoint and the stage its source scored." ;
    obo:IAO_0100001 onsir:Nicotiana_tabacum_SeedlingPerformance_BelowFavourableBandDose ;
    owl:deprecated true ;
    skos:definition "OBSOLETE. A dose window of release 1.6.0 for Nicotiana tabacum, conditioned on the taxon alone. Replaced by a window that is also conditioned on the endpoint and the stage its source scored." .

onsir:Nicotiana_tabacum_SeedlingPerformance_CotyledonFreeing_EarlySeedlingStage_BandUpperEndProbe a owl:Class ;
    rdfs:label "Nicotiana tabacum seedling performance cotyledon freeing early seedling stage band upper end probe"@en ;
    obo:IAO_0000115 "A dose assessment of Nicotiana tabacum for cotyledon freeing at the early seedling stage, at the upper end of the favourable band reported for that taxon, 15 Gy. The class is unsatisfiable when that dose also lies at or above an LD50 reported for the same taxon, endpoint and stage, which flags a band that reaches its LD50 for a curator." ;
    rdfs:comment "A probe for the reasoner, one for each endpoint and stage of a favourable band: it is satisfiable while the band lies below every LD50 reported for the same taxon, endpoint and stage." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_4097 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:CotyledonFreeing ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:EarlySeedlingStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:double ;
                                owl:withRestrictions ( [ xsd:minInclusive 1.5e+01 ] [ xsd:maxInclusive 1.5e+01 ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Nicotiana tabacum for cotyledon freeing at the early seedling stage, at the upper end of the favourable band reported for that taxon, 15 Gy. The class is unsatisfiable when that dose also lies at or above an LD50 reported for the same taxon, endpoint and stage, which flags a band that reaches its LD50 for a curator." .

onsir:Nicotiana_tabacum_SeedlingPerformance_CotyledonFreeing_GerminationStage_BandUpperEndProbe a owl:Class ;
    rdfs:label "Nicotiana tabacum seedling performance cotyledon freeing germination stage band upper end probe"@en ;
    obo:IAO_0000115 "A dose assessment of Nicotiana tabacum for cotyledon freeing at the germination stage, at the upper end of the favourable band reported for that taxon, 15 Gy. The class is unsatisfiable when that dose also lies at or above an LD50 reported for the same taxon, endpoint and stage, which flags a band that reaches its LD50 for a curator." ;
    rdfs:comment "A probe for the reasoner, one for each endpoint and stage of a favourable band: it is satisfiable while the band lies below every LD50 reported for the same taxon, endpoint and stage." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_4097 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:CotyledonFreeing ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:GerminationStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:onDatatype xsd:double ;
                                owl:withRestrictions ( [ xsd:minInclusive 1.5e+01 ] [ xsd:maxInclusive 1.5e+01 ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Nicotiana tabacum for cotyledon freeing at the germination stage, at the upper end of the favourable band reported for that taxon, 15 Gy. The class is unsatisfiable when that dose also lies at or above an LD50 reported for the same taxon, endpoint and stage, which flags a band that reaches its LD50 for a curator." .

onsir:Nicotiana_tabacum_SeedlingPerformance_FreshMass_EarlySeedlingStage_BandUpperEndProbe a owl:Class ;
    rdfs:label "Nicotiana tabacum seedling performance fresh mass early seedling stage band upper end probe"@en ;
    obo:IAO_0000115 "A dose assessment of Nicotiana tabacum for fresh mass at the early seedling stage, at the upper end of the favourable band reported for that taxon, 15 Gy. The class is unsatisfiable when that dose also lies at or above an LD50 reported for the same taxon, endpoint and stage, which flags a band that reaches its LD50 for a curator." ;
    rdfs:comment "A probe for the reasoner, one for each endpoint and stage of a favourable band: it is satisfiable while the band lies below every LD50 reported for the same taxon, endpoint and stage." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_4097 ] ] [ a owl:Restriction ;
