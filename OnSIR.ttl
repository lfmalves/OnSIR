onsir:Nicotiana_tabacum_WithinFavourableBandDose a owl:Class ;
    rdfs:label "obsolete Nicotiana tabacum within favourable band dose"@en ;
    obo:IAO_0000115 "OBSOLETE. A dose window of release 1.6.0 for Nicotiana tabacum, conditioned on the taxon alone. Replaced by a window that is also conditioned on the endpoint and the stage its source scored." ;
    obo:IAO_0100001 onsir:Nicotiana_tabacum_SeedlingPerformance_WithinFavourableBandDose ;
    owl:deprecated true ;
    skos:definition "OBSOLETE. A dose window of release 1.6.0 for Nicotiana tabacum, conditioned on the taxon alone. Replaced by a window that is also conditioned on the endpoint and the stage its source scored." .

onsir:NoDetectedResponseOutcome a owl:Class ;
    rdfs:label "no detected response outcome"@en ;
    obo:IAO_0000115 "A treatment outcome with no response: the endpoints measured did not differ from the unirradiated control." ;
    rdfs:comment "An outcome enters this class when it is asserted to have no response (hasResponse max 0). An outcome that records no response without that assertion stays unclassified, because OWL does not infer the absence of an unrecorded value." ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                        owl:maxCardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty onsir:hasResponse ] ) ] ;
    skos:definition "A treatment outcome with no response: the endpoints measured did not differ from the unirradiated control." .

onsir:Plant a owl:Class ;
    rdfs:label "plant"@en ;
    obo:IAO_0000115 "A whole plant." ;
    obo:IAO_0000119 "Plant Ontology (Cooper et al. 2013), checked on the EBI Ontology Lookup Service, PO:0000003 whole plant" ;
    rdfs:subClassOf obo:BFO_0000040,
        obo:PO_0000003 ;
    skos:definition "A whole plant." .

onsir:PlantBulb a owl:Class ;
    rdfs:label "plant bulb"@en ;
    obo:IAO_0000115 "A bulb: a short underground shoot whose fleshy leaves or leaf bases store reserves, as in onion, shallot and tuberose. A garlic clove is a bulblet." ;
    obo:IAO_0000119 "Plant Ontology (Cooper et al. 2013), checked on the EBI Ontology Lookup Service, PO:0025356 bulb" ;
    rdfs:subClassOf onsir:PlantPart ;
    owl:equivalentClass obo:PO_0025356 ;
    skos:definition "A bulb: a short underground shoot whose fleshy leaves or leaf bases store reserves, as in onion, shallot and tuberose. A garlic clove is a bulblet." .

onsir:PlantCallus a owl:Class ;
    rdfs:label "plant callus"@en ;
    obo:IAO_0000115 "A plant callus: a mass of mostly parenchyma cells, formed on wounding or in tissue culture, irradiated as the propagule in in vitro mutagenesis." ;
    obo:IAO_0000119 "Plant Ontology (Cooper et al. 2013), checked on the EBI Ontology Lookup Service, PO:0005052 plant callus" ;
    rdfs:subClassOf onsir:PlantPart ;
    owl:equivalentClass obo:PO_0005052 ;
    skos:definition "A plant callus: a mass of mostly parenchyma cells, formed on wounding or in tissue culture, irradiated as the propagule in in vitro mutagenesis." .

onsir:PlantSeed a owl:Class ;
    rdfs:label "plant seed"@en ;
    obo:IAO_0000115 "A seed: the propagule of a seed plant, which generally develops from an ovule after fertilization." ;
    obo:IAO_0000119 "Plant Ontology (Cooper et al. 2013), checked on the EBI Ontology Lookup Service, PO:0009010 seed" ;
    rdfs:subClassOf obo:BFO_0000040,
        onsir:PlantPart ;
    owl:equivalentClass obo:PO_0009010 ;
    skos:definition "A seed: the propagule of a seed plant, which generally develops from an ovule after fertilization." .

onsir:PlantTuber a owl:Class ;
    rdfs:label "plant tuber"@en ;
    obo:IAO_0000115 "A shoot axis tuber: a swollen stem that stores reserves, as in the potato." ;
    obo:IAO_0000119 "Plant Ontology (Cooper et al. 2013), checked on the EBI Ontology Lookup Service, PO:0004543 shoot axis tuber" ;
    rdfs:subClassOf onsir:PlantPart ;
    owl:equivalentClass obo:PO_0004543 ;
    skos:definition "A shoot axis tuber: a swollen stem that stores reserves, as in the potato." .

onsir:Plukenetia_volubilis_SeedlingSurvival_AtOrAboveLD50Dose a owl:Class ;
    rdfs:label "Plukenetia volubilis seedling survival at or above LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Plukenetia volubilis for seedling survival in the early seedling stage, at a dose at or above the LD50 of 618.78 Gy that Corazon-Guivin et al. (2023) estimate." ;
    dct:source "Corazon-Guivin et al. 2023, Adv. Agric. 2023:9737125, doi:10.1155/2023/9737125" ;
    rdfs:subClassOf onsir:AtOrAboveReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_316893 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:EarlySeedlingStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 618.78 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 6.1878e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Plukenetia volubilis for seedling survival in the early seedling stage, at a dose at or above the LD50 of 618.78 Gy that Corazon-Guivin et al. (2023) estimate." ;
    skos:scopeNote "The source irradiated doses from 500 to 900 Gy and scored surviving plants per irradiated seed in a greenhouse sowing, with growth recorded 30 days after emergence; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "A logistic regression of mortality on dose (a generalized linear model) gives 618.78 Gy, inside the tested range of 500 to 900 Gy." ;
    onsir:sourceStatement "A logistic regression between radiation doses and mortality was calculated to estimate the optimum LD50 using a generalized linear model. [...] the LD50 of the dosimetry assay was 618.78 Gy." .

onsir:Plukenetia_volubilis_SeedlingSurvival_BelowLD50Dose a owl:Class ;
    rdfs:label "Plukenetia volubilis seedling survival below LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Plukenetia volubilis for seedling survival in the early seedling stage, at a dose below the LD50 of 618.78 Gy that Corazon-Guivin et al. (2023) estimate." ;
    dct:source "Corazon-Guivin et al. 2023, Adv. Agric. 2023:9737125, doi:10.1155/2023/9737125" ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_316893 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:EarlySeedlingStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxExclusive 618.78 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxExclusive 6.1878e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Plukenetia volubilis for seedling survival in the early seedling stage, at a dose below the LD50 of 618.78 Gy that Corazon-Guivin et al. (2023) estimate." ;
    skos:scopeNote "The source irradiated doses from 500 to 900 Gy and scored surviving plants per irradiated seed in a greenhouse sowing, with growth recorded 30 days after emergence; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "A logistic regression of mortality on dose (a generalized linear model) gives 618.78 Gy, inside the tested range of 500 to 900 Gy." ;
    onsir:sourceStatement "A logistic regression between radiation doses and mortality was calculated to estimate the optimum LD50 using a generalized linear model. [...] the LD50 of the dosimetry assay was 618.78 Gy." .

onsir:PollenSterility a owl:Class ;
    rdfs:label "pollen sterility"@en ;
    obo:IAO_0000115 "The percentage of pollen grains that are not viable in a viability test." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0000437 ;
    skos:definition "The percentage of pollen grains that are not viable in a viability test." .

onsir:ROSBalanceShift a owl:Class ;
    rdfs:label "ROS balance shift"@en ;
    obo:IAO_0000115 "A change in the level of reactive oxygen species, or in the balance between their production and removal, measured after irradiation relative to the unirradiated control." ;
    rdfs:subClassOf onsir:BiochemicalChange ;
    skos:definition "A change in the level of reactive oxygen species, or in the balance between their production and removal, measured after irradiation relative to the unirradiated control." ;
    skos:relatedMatch obo:CHEBI_26523,
        obo:TO_0002657 .

onsir:RootLength a owl:Class ;
    rdfs:label "root length"@en ;
    obo:IAO_0000115 "The length of the primary root or of the root system of a seedling or plant." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0000227 ;
    skos:definition "The length of the primary root or of the root system of a seedling or plant." .

onsir:SeedStage a owl:Class ;
    rdfs:label "seed stage"@en ;
    obo:IAO_0000115 "The stage at which the propagule is a quiescent seed, before imbibition." ;
    rdfs:subClassOf onsir:LifecycleStage ;
    skos:definition "The stage at which the propagule is a quiescent seed, before imbibition." .

onsir:SeedSterility a owl:Class ;
    rdfs:label "seed sterility"@en ;
    obo:IAO_0000115 "The percentage of flowers or spikelets that fail to set seed." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:broadMatch obo:TO_0000485 ;
    skos:definition "The percentage of flowers or spikelets that fail to set seed." .

onsir:Seedling a owl:Class ;
    rdfs:label "seedling"@en ;
    obo:IAO_0000115 "A young plant derived from a newly germinated seed, up to the development of its first true leaf." ;
    obo:IAO_0000119 "Plant Ontology (Cooper et al. 2013), checked on the EBI Ontology Lookup Service, PO:0008037 seedling" ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass obo:PO_0008037 ;
    skos:definition "A young plant derived from a newly germinated seed, up to the development of its first true leaf." .

onsir:SeedlingVigorIndex a owl:Class ;
    rdfs:label "seedling vigour index"@en ;
    obo:IAO_0000115 "An index of seedling vigour that combines germination with seedling growth, such as germination percentage multiplied by seedling length or dry mass." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0000280 ;
    skos:definition "An index of seedling vigour that combines germination with seedling growth, such as germination percentage multiplied by seedling length or dry mass." .

onsir:ShootLength a owl:Class ;
    rdfs:label "shoot length"@en ;
    obo:IAO_0000115 "The length of the shoot of a seedling or plant." ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:TO_0001158 ;
    skos:definition "The length of the shoot of a seedling or plant." .

onsir:SoilCondition a owl:Class ;
    rdfs:label "soil condition"@en ;
    obo:IAO_0000115 "The soil in which plants were grown, or a property of it." ;
    rdfs:subClassOf onsir:Context ;
    skos:closeMatch obo:PECO_0007049 ;
    skos:definition "The soil in which plants were grown, or a property of it." .

onsir:Solanum_lycopersicum_SeedlingSurvival_BelowLD50Dose a owl:Class ;
    rdfs:label "Solanum lycopersicum seedling survival below LD50 dose"@en ;
    obo:IAO_0000115 "A dose assessment of Solanum lycopersicum for seedling survival in the early seedling stage, at a dose of 120 Gy or less; at 120 Gy, the highest dose of Indrayanti et al. (2024), 59 % of seedlings relative to the control were alive." ;
    dct:source "Indrayanti et al. 2024, Pak. J. Phytopathol. 36(2):267-280, doi:10.33866/phytopathol.036.02.1047" ;
    rdfs:subClassOf onsir:BelowReportedLD50 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:onProperty onsir:hasSubject ;
                        owl:someValuesFrom [ a owl:Restriction ;
                                owl:onProperty obo:RO_0002162 ;
                                owl:someValuesFrom obo:NCBITaxon_4081 ] ] [ a owl:Restriction ;
                        owl:onProperty onsir:forEndpoint ;
                        owl:someValuesFrom onsir:SeedlingSurvival ] [ a owl:Restriction ;
                        owl:onProperty onsir:atStage ;
                        owl:someValuesFrom onsir:EarlySeedlingStage ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 120.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 1.2e+02 ] ) ] ) ] ] ) ] ;
    skos:definition "A dose assessment of Solanum lycopersicum for seedling survival in the early seedling stage, at a dose of 120 Gy or less; at 120 Gy, the highest dose of Indrayanti et al. (2024), 59 % of seedlings relative to the control were alive." ;
    skos:scopeNote "The source irradiated doses from 50 to 120 Gy and scored seedlings alive four weeks after germination, relative to the unirradiated control; where the window extends past the tested doses, the position is arithmetic only." ;
    onsir:boundQualifier "The source fits a quadratic to the number of seedlings alive four weeks after germination, relative to the control, and reports 132.49 Gy, above its highest dose of 120 Gy, at which 59 % of seedlings relative to the control were alive. 120 Gy is encoded as a lower bound on the LD50, so only the window below the LD50 is defined, and it includes 120 Gy." ;
    onsir:sourceStatement "The analysis of the lethal dose showed a 50% reduction in plant growth of tomato cv. 'Timothy' F1 was obtained at 132.49 Gy." .

onsir:StimulatoryOutcome a owl:Class ;
    rdfs:label "stimulatory outcome"@en ;
    obo:IAO_0000115 "A treatment outcome that has a hormetic response." ;
