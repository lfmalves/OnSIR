@prefix dct: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix onsir: <https://w3id.org/onsir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

qudt:numericValue a owl:DatatypeProperty ;
    rdfs:label "numeric value"@en ;
    rdfs:range xsd:double .

qudt:unit a owl:ObjectProperty ;
    rdfs:label "unit"@en .

<https://w3id.org/onsir> a owl:Ontology ;
    dct:created "2025-09-21"^^xsd:date ;
    dct:creator "Ferrucio de Franco Rosa",
        "Luis Felipe Medeiro Alves",
        "Valter Arthur" ;
    dct:description "A FAIR OWL 2 DL ontology of seed-irradiation treatments and their dose-dependent biological effects (hormetic, mutagenic, sterilizing), aligned to BFO, PO, NCBITaxon, ChEBI, UO and PATO, with dose-to-effect axioms supporting DL reasoning." ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:modified "2026-07-24"^^xsd:date ;
    dct:source <https://doi.org/10.22456/2175-2745.146658>,
        <https://doi.org/10.56238/sevened2025.039-003>,
        <https://doi.org/10.69547/TSFJB.030203> ;
    dct:title "OnSIR: Ontology for Seed Irradiation and Plant Radiobiology" ;
    rdfs:comment "Canonical IRI https://w3id.org/onsir; source at https://github.com/lfmalves/OnSIR" ;
    rdfs:seeAlso obo:rbo.owl ;
    owl:versionIRI onsir:1.0.0 ;
    owl:versionInfo "1.0.0" .

onsir:AbioticStressResistance a owl:Class ;
    rdfs:label "Abiotic Stress Resistance"@en ;
    rdfs:subClassOf onsir:StressResistance .

onsir:AntioxidantActivity a owl:Class ;
    rdfs:label "AntioxidantActivity"@en ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:CHEBI_22586 .

onsir:AntioxidantIncrease a owl:Class ;
    rdfs:label "Antioxidant Increase"@en ;
    rdfs:subClassOf onsir:BiochemicalChange ;
    skos:closeMatch obo:CHEBI_22586 .

onsir:BioticStressResistance a owl:Class ;
    rdfs:label "Biotic Stress Resistance"@en ;
    rdfs:subClassOf onsir:StressResistance .

onsir:Capsicum_annuum_MutagenicDose a owl:Class ;
    dct:source "Esmaiel et al. 2025, J. Agric. Biol. Res. 11(1):44-55" ;
    rdfs:comment "mutagenic dose window for Capsicum annuum: bounds from Esmaiel et al. 2025, J. Agric. Biol. Res. 11(1):44-55" ;
    rdfs:subClassOf onsir:MutagenicDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Capsicum_annuum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 50.0 ] [ xsd:maxExclusive 200.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 5e+01 ] [ xsd:maxExclusive 2e+02 ] ) ] ) ] ] ) ] .

onsir:Capsicum_annuum_SterilizingDose a owl:Class ;
    dct:source "Esmaiel et al. 2025, J. Agric. Biol. Res. 11(1):44-55" ;
    rdfs:comment "sterilizing dose window for Capsicum annuum: bounds from Esmaiel et al. 2025, J. Agric. Biol. Res. 11(1):44-55" ;
    rdfs:subClassOf onsir:SterilizingDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Capsicum_annuum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 200.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 2e+02 ] ) ] ) ] ] ) ] .

onsir:Capsicum_annuum_StimulatoryDose a owl:Class ;
    dct:source "Esmaiel et al. 2025, J. Agric. Biol. Res. 11(1):44-55" ;
    rdfs:comment "stimulatory dose window for Capsicum annuum: bounds from Esmaiel et al. 2025, J. Agric. Biol. Res. 11(1):44-55" ;
    rdfs:subClassOf onsir:StimulatoryDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Capsicum_annuum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 50.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 5e+01 ] ) ] ) ] ] ) ] .

onsir:ChlorophyllContent a owl:Class ;
    rdfs:label "ChlorophyllContent"@en ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:CHEBI_28966 .

onsir:CotyledonFreeing a owl:Class ;
    rdfs:label "CotyledonFreeing"@en ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:PO_0020030 .

onsir:DryMass a owl:Class ;
    rdfs:label "DryMass"@en ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:PATO_0000125 .

onsir:EarlySeedlingStage a owl:Class ;
    rdfs:label "Early Seedling Stage"@en ;
    rdfs:subClassOf onsir:LifecycleStage .

onsir:EnzymeActivityChange a owl:Class ;
    rdfs:label "Enzyme Activity Change"@en ;
    rdfs:subClassOf onsir:BiochemicalChange .

onsir:FreshMass a owl:Class ;
    rdfs:label "FreshMass"@en ;
    rdfs:subClassOf onsir:Endpoint ;
    skos:closeMatch obo:PATO_0000125 .

onsir:GerminationStage a owl:Class ;
    rdfs:label "Germination Stage"@en ;
    rdfs:subClassOf onsir:LifecycleStage ;
    skos:closeMatch obo:PO_0007057 .

onsir:LightCondition a owl:Class ;
    rdfs:label "Light Condition"@en ;
    rdfs:subClassOf onsir:Context .

onsir:LipidPeroxidation a owl:Class ;
    rdfs:label "LipidPeroxidation"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:MutagenicOutcome a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                        owl:onProperty onsir:hasResponse ;
                        owl:someValuesFrom onsir:MutagenicResponse ] ) ] .

onsir:Nicotiana_tabacum_MutagenicDose a owl:Class ;
    dct:source "Alves & Arthur 2025, TSF J. Biol. 3(2):26-51" ;
    rdfs:comment "mutagenic dose window for Nicotiana tabacum: bounds from Alves & Arthur 2025, TSF J. Biol. 3(2):26-51" ;
    rdfs:subClassOf onsir:MutagenicDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Nicotiana_tabacum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 15.0 ] [ xsd:maxExclusive 25.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 1.5e+01 ] [ xsd:maxExclusive 2.5e+01 ] ) ] ) ] ] ) ] .

onsir:Nicotiana_tabacum_SterilizingDose a owl:Class ;
    dct:source "Alves & Arthur 2025, TSF J. Biol. 3(2):26-51" ;
    rdfs:comment "sterilizing dose window for Nicotiana tabacum: bounds from Alves & Arthur 2025, TSF J. Biol. 3(2):26-51" ;
    rdfs:subClassOf onsir:SterilizingDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Nicotiana_tabacum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 25.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 2.5e+01 ] ) ] ) ] ] ) ] .

onsir:Nicotiana_tabacum_StimulatoryDose a owl:Class ;
    dct:source "Alves & Arthur 2025, TSF J. Biol. 3(2):26-51" ;
    rdfs:comment "stimulatory dose window for Nicotiana tabacum: bounds from Alves & Arthur 2025, TSF J. Biol. 3(2):26-51" ;
    rdfs:subClassOf onsir:StimulatoryDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Nicotiana_tabacum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 15.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 1.5e+01 ] ) ] ) ] ] ) ] .

onsir:Outcome_Co60_GerminationHormesis a onsir:TreatmentOutcome ;
    onsir:forEndpoint onsir:GerminationRate ;
    onsir:hasDoseCategory onsir:HormeticDose ;
    onsir:hasModel onsir:Model_BC_Germination ;
    onsir:hasResponse onsir:Resp_GerminationHormesis ;
    onsir:hasSubject onsir:PlantSeed ;
    onsir:hasTreatment onsir:Treat_Co60_Gamma_50Gy .

onsir:Outcome_UVC_Sterilization a onsir:TreatmentOutcome ;
    onsir:forEndpoint onsir:SeedSterility ;
    onsir:hasDoseCategory onsir:SterilizationDose ;
    onsir:hasResponse onsir:Resp_Sterility ;
    onsir:hasSubject onsir:PlantSeed ;
    onsir:hasTreatment onsir:Treat_UVC_254nm_1200Jm2 .

onsir:Outcome_XRay_Mutagenesis a onsir:TreatmentOutcome ;
    onsir:forEndpoint onsir:MutationFrequency ;
    onsir:hasDoseCategory onsir:MutagenicDose ;
    onsir:hasResponse onsir:Resp_Mutagenesis ;
    onsir:hasSubject onsir:PlantSeed ;
    onsir:hasTreatment onsir:Treat_XRay_150Gy .

onsir:Plant a owl:Class ;
    rdfs:label "Plant"@en ;
    rdfs:subClassOf obo:BFO_0000040 .

onsir:PlantPart a owl:Class ;
    rdfs:label "Plant Part"@en ;
    rdfs:subClassOf obo:BFO_0000040,
        obo:PO_0025131 .

onsir:PollenSterility a owl:Class ;
    rdfs:label "PollenSterility"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:ROSBalanceShift a owl:Class ;
    rdfs:label "ROS Balance Shift"@en ;
    rdfs:subClassOf onsir:BiochemicalChange ;
    skos:closeMatch obo:CHEBI_26523 .

onsir:RootLength a owl:Class ;
    rdfs:label "RootLength"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:SeedStage a owl:Class ;
    rdfs:label "Seed Stage"@en ;
    rdfs:subClassOf onsir:LifecycleStage .

onsir:Seedling a owl:Class ;
    rdfs:label "Seedling"@en ;
    rdfs:subClassOf obo:BFO_0000040 ;
    owl:equivalentClass obo:PO_0008037 .

onsir:SeedlingVigorIndex a owl:Class ;
    rdfs:label "SeedlingVigorIndex"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:ShootLength a owl:Class ;
    rdfs:label "ShootLength"@en ;
    rdfs:subClassOf onsir:Endpoint .

onsir:SoilCondition a owl:Class ;
    rdfs:label "Soil Condition"@en ;
    rdfs:comment "Integration touchpoint: map to external 'SoilCondition' in farm ontologies."@en ;
    rdfs:subClassOf onsir:Context ;
    skos:closeMatch obo:ENVO_00001998 .

onsir:StimulatoryOutcome a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:TreatmentOutcome [ a owl:Restriction ;
                        owl:onProperty onsir:hasResponse ;
                        owl:someValuesFrom onsir:HormeticResponse ] ) ] .

onsir:Substrate a owl:Class ;
    rdfs:label "Substrate"@en ;
    rdfs:subClassOf onsir:Context .

onsir:TemperatureCondition a owl:Class ;
    rdfs:label "Temperature Condition"@en ;
    rdfs:subClassOf onsir:Context ;
    skos:closeMatch obo:PATO_0000146 .

onsir:Trigonella_foenum_graecum_MutagenicDose a owl:Class ;
    dct:source "Latha et al. 2017, J. AgriSearch 4(1):28-33" ;
    rdfs:comment "mutagenic dose window for Trigonella foenum-graecum: bounds from Latha et al. 2017, J. AgriSearch 4(1):28-33" ;
    rdfs:subClassOf onsir:MutagenicDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Trigonella_foenum_graecum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 150.0 ] [ xsd:maxExclusive 350.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 1.5e+02 ] [ xsd:maxExclusive 3.5e+02 ] ) ] ) ] ] ) ] .

onsir:Trigonella_foenum_graecum_SterilizingDose a owl:Class ;
    dct:source "Latha et al. 2017, J. AgriSearch 4(1):28-33" ;
    rdfs:comment "sterilizing dose window for Trigonella foenum-graecum: bounds from Latha et al. 2017, J. AgriSearch 4(1):28-33" ;
    rdfs:subClassOf onsir:SterilizingDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Trigonella_foenum_graecum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minInclusive 350.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minInclusive 3.5e+02 ] ) ] ) ] ] ) ] .

onsir:Trigonella_foenum_graecum_StimulatoryDose a owl:Class ;
    dct:source "Latha et al. 2017, J. AgriSearch 4(1):28-33" ;
    rdfs:comment "stimulatory dose window for Trigonella foenum-graecum: bounds from Latha et al. 2017, J. AgriSearch 4(1):28-33" ;
    rdfs:subClassOf onsir:StimulatoryDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Trigonella_foenum_graecum ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0.0 ] [ xsd:maxInclusive 150.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 0e+00 ] [ xsd:maxInclusive 1.5e+02 ] ) ] ) ] ] ) ] .

onsir:Vigna_unguiculata_MutagenicDose a owl:Class ;
    dct:source "Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33" ;
    rdfs:comment "mutagenic dose window for Vigna unguiculata: bounds from Gnankambary et al. 2019, Int. J. Genet. Mol. Biol. 11(2):29-33" ;
    rdfs:subClassOf onsir:MutagenicDoseAssessment ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( onsir:DoseAssessment [ a owl:Restriction ;
                        owl:hasValue onsir:taxon_Vigna_unguiculata ;
                        owl:onProperty onsir:forTaxon ] [ a owl:Restriction ;
                        owl:onProperty onsir:doseGy ;
                        owl:someValuesFrom [ a rdfs:Datatype ;
                                owl:unionOf ( [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:decimal ;
                                            owl:withRestrictions ( [ xsd:minExclusive 80.0 ] [ xsd:maxExclusive 132.0 ] ) ] [ a rdfs:Datatype ;
                                            owl:onDatatype xsd:double ;
                                            owl:withRestrictions ( [ xsd:minExclusive 8e+01 ] [ xsd:maxExclusive 1.32e+02 ] ) ] ) ] ] ) ] .

onsir:Vigna_unguiculata_SterilizingDose a owl:Class ;
